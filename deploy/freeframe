# For an own domain: show the DNS records, then wait until they point here,
# so a typo never burns Let's Encrypt attempts. With a terminal the person
# can switch to the automatic address or continue anyway.
_install_dns_step() {
  local -a names=()
  local n waited=0 max=${FF_DNS_WAIT:-1800} answer rc interactive=0 can_switch=0
  [[ $FF_MODE == own ]] || return 0
  FF_STEP="checking the DNS records"
  names=("$FF_HOST")
  if [[ $FF_STORAGE == bundled ]]; then names+=("storage.$FF_HOST"); fi
  if _install_dns_ok "${names[@]}"; then
    say "The DNS records for $FF_HOST point at this server."
    return 0
  fi
  say ""
  say "Your web address must point at this server before HTTPS can be set up."
  say "Add these DNS records where you manage your domain (at the company you bought it from,"
  say "look for \"DNS\" or \"DNS records\"):"
  for n in "${names[@]}"; do
    say "  Add an A record with the name $(_ff_dns_label "$n") and the value $FF_IP   (for $n)"
  done
  say "If there is an AAAA record for these names, remove it unless it points at this server."
  say "New records usually work within a few minutes, sometimes up to an hour."
  if [[ -z ${FF_ADDR_FROM_FILE:-} ]] && is_public_ipv4 "$FF_IP"; then can_switch=1; fi
  if _ff_interactive && _ff_tty_open; then
    interactive=1
    say ""
    say "Checking every 15 seconds. Press Enter to check now, or type c and Enter to continue anyway."
    if ((can_switch)); then
      say "Or type s and Enter to use the free temporary address $(sslip_host "$FF_IP") instead."
    fi
  fi
  while ! _install_dns_ok "${names[@]}"; do
    if ((interactive)); then
      answer=""
      rc=0
      IFS= read -r -t 15 -u "$_FF_TTY_FD" answer || rc=$?
      ((rc <= 128)) || continue
      if ((rc != 0)) && [[ -z $answer ]]; then
        interactive=0
        continue
      fi
      case ${answer,,} in
        s)
          if ((can_switch)); then
            FF_HTTPS=sslip FF_MODE=sslip FF_DOMAIN="" FF_HOST=$(sslip_host "$FF_IP")
            if [[ ${FF_CMD:-install} == configure ]]; then
              say "Using the temporary address $FF_HOST instead."
            else
              say "Using the temporary address $FF_HOST instead. Change it later with: sudo freeframe configure"
            fi
            return 0
          fi
          ;;
        c)
          warn "Continuing before the records point here. The HTTPS certificate cannot be issued until they do."
          return 0
          ;;
      esac
    else
      if ((waited >= max)); then
        if [[ ${FF_CMD:-install} == configure ]]; then
          install_fail "The DNS records for $FF_HOST do not point at this server ($FF_IP) yet, so the web address was not changed." \
            "add the records shown above, then run sudo freeframe configure again once they work."
        fi
        install_fail "The DNS records for $FF_HOST do not point at this server ($FF_IP) yet." \
          "add the records shown above and run sudo freeframe install again once they work, or install now with the temporary address instead: leave out the domain and set FREEFRAME_HTTPS=sslip."
      fi
      ff_sleep 15
      waited=$((waited + 15))
    fi
  done
  say "The DNS records point at this server."
}

FF_SETUP_FILES=(docker-compose.prod.yml docker-compose.images.yml docker-compose.https.yml docker-compose.storage.yml
  deploy/systemd/freeframe-backup.service deploy/systemd/freeframe-backup.timer)

# _ff_setup_dest PATH: where the setup file PATH (as in the repository) lives
# on this server: the compose files in $FF_ROOT, the units in $FF_ROOT/systemd.
_ff_setup_dest() {
  local root
  root=$(ff_root)
  if [[ $1 == deploy/systemd/* ]]; then printf '%s/systemd/%s' "$root" "${1##*/}"; else printf '%s/%s' "$root" "$1"; fi
}

# fetch_setup_files REF: download the compose files and the nightly backup
# units from REF into $FF_ROOT (the units into $FF_ROOT/systemd, where
# install_backup_timer takes them from). All or nothing: every file is
# downloaded first, and when moving one into place fails, those already
# moved are put back, so the old set stays whole. On failure it returns 1,
# FF_FETCH_FAILED names the file, FF_FETCH_STAGE is download or move, and
# FF_FETCH_MIXED=1 says the old set could not be put back completely.
fetch_setup_files() {
  local ref=$1 root stage f dest name i
  local -a moved=()
  root=$(ff_root)
  FF_FETCH_FAILED="" FF_FETCH_STAGE=download FF_FETCH_MIXED=""
  mkdir -p "$root/systemd" || return 1
  stage=$(mktemp -d "$root/.download.XXXXXX") || return 1
  for f in "${FF_SETUP_FILES[@]}"; do
    if ! _ff_logged fetch "$ref" "$f" "$stage/${f##*/}"; then
      FF_FETCH_FAILED=$f
      rm -rf "$stage"
      return 1
    fi
  done
  FF_FETCH_STAGE=move
  mkdir "$stage/old" || {
    rm -rf "$stage"
    return 1
  }
  # The replace takes a moment and must not be cut in half: a Ctrl-C, a
  # closed SSH session or a TERM is held until it is done, then delivered.
  _ff_hold_signals
  for f in "${FF_SETUP_FILES[@]}"; do
    dest=$(_ff_setup_dest "$f")
    name=${f##*/}
    if { [[ ! -e $dest ]] || cp -p "$dest" "$stage/old/$name"; } && mv -f "$stage/$name" "$dest"; then
      moved+=("$f")
      continue
    fi
    FF_FETCH_FAILED=$f
    # Put back what was already replaced (a file that was not there before
    # is removed again).
    for ((i = ${#moved[@]} - 1; i >= 0; i--)); do
      dest=$(_ff_setup_dest "${moved[i]}")
      name=${moved[i]##*/}
      if [[ -e $stage/old/$name ]]; then
        mv -f "$stage/old/$name" "$dest" || FF_FETCH_MIXED=1
      else
        rm -f "$dest" || FF_FETCH_MIXED=1
      fi
    done
    rm -rf "$stage"
    _ff_release_signals
    return 1
  done
  rm -rf "$stage"
  _ff_release_signals
}

# _ff_hold_signals / _ff_release_signals: hold INT, TERM and HUP during a
# short step that must finish once begun; afterwards the traps that were
# set come back, and a signal that arrived meanwhile is delivered then.
_ff_hold_signals() {
  FF_HELD_TRAPS=$(trap -p INT TERM HUP)
  FF_SIG_PENDING=""
  trap 'FF_SIG_PENDING=INT' INT
  trap 'FF_SIG_PENDING=TERM' TERM
  trap 'FF_SIG_PENDING=HUP' HUP
}

_ff_release_signals() {
  local sig=${FF_SIG_PENDING:-}
  trap - INT TERM HUP
  eval "${FF_HELD_TRAPS:-}"
  FF_SIG_PENDING="" FF_HELD_TRAPS=""
  if [[ -n $sig ]]; then kill -s "$sig" "$$"; fi
  return 0
}

# _ff_fetch_failure CHANNEL_WORDS: the message for a failed fetch_setup_files.
_ff_fetch_failure() {
  if [[ $FF_FETCH_STAGE == download ]]; then
    printf 'Could not download %s for %s, so none of the setup files was replaced.' "${FF_FETCH_FAILED:-the setup files}" "$1"
  elif [[ -n $FF_FETCH_MIXED ]]; then
    printf 'The new %s could not be put in place, and some of the setup files from before could not be put back either.' "${FF_FETCH_FAILED:-setup files}"
  else
    printf 'The new %s could not be put in place, so none of the setup files was replaced.' "${FF_FETCH_FAILED:-setup files}"
  fi
}

_install_fetch_step() {
  local root
  root=$(ff_root)
  FF_STEP="downloading the setup files"
  say "Downloading the setup files for the $FF_CHANNEL channel..."
  if ! fetch_setup_files "$FF_CHANNEL"; then
    install_fail "$(_ff_fetch_failure "the $FF_CHANNEL channel")" \
      "check that this server can reach raw.githubusercontent.com, then run sudo freeframe install again. If it can, the $FF_CHANNEL channel may not have this file yet (the installer needs a release after v1.21.0): try --channel latest."
  fi
  _install_done "downloaded the setup files into $root"
}

# Fill the settings file. An existing file (copied from another server, or
# an earlier attempt) is only completed, never changed, and it is backed up
# first whenever something is added.
# fill_settings FILE [CHANNEL]: complete FILE with derive_env: only missing
# or empty keys are added and secrets are never replaced (spec goal 6). With
# CHANNEL, FREEFRAME_CHANNEL is set to it first (an explicit --channel). The
# work happens on a copy: when the copy differs, FILE is backed up
# (env_backup) and the copy moved over it; otherwise FILE stays byte for byte
# as it was. FILE always ends mode 600. 1 on failure (with a message).
fill_settings() {
  local file=$1 ch=${2:-} tmp
  if ! tmp=$(mktemp "$file.new.XXXXXX"); then
    warn "Cannot write next to $file."
    return 1
  fi
  if ! cp -p "$file" "$tmp"; then
    rm -f "$tmp"
    warn "Cannot copy $file."
    return 1
  fi
  if [[ -n $ch && $(env_get "$tmp" FREEFRAME_CHANNEL) != "$ch" ]] && ! env_set "$tmp" FREEFRAME_CHANNEL "$ch"; then
    rm -f "$tmp"
    return 1
  fi
  if ! derive_env "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if cmp -s "$file" "$tmp"; then
    rm -f "$tmp"
  elif ! env_backup "$file" >/dev/null; then
    rm -f "$tmp"
    warn "Could not back up $file."
    return 1
  elif ! mv -f "$tmp" "$file"; then
    rm -f "$tmp"
    return 1
  fi
  chmod 600 "$file"
}

_install_settings_step() {
  local file=$1
  FF_STEP="writing the settings"
  if [[ -f $file ]]; then
    if ! fill_settings "$file" "$FF_CHANNEL"; then
      install_fail "The settings could not be completed." "fix what the message above says, then run sudo freeframe install again."
    fi
  elif ! derive_env "$file"; then
    install_fail "The settings could not be written." "fix what the message above says, then run sudo freeframe install again."
  fi
  # Also when nothing had to be added: a file copied in with wider
  # permissions still holds the passwords.
  chmod 600 "$file" || install_fail "Cannot make $file private (chmod 600 failed)." "check the disk, then run sudo freeframe install again."
  FF_STATE="Your settings are saved in $file. Running sudo freeframe install again keeps them and continues from here."
}

_install_wait_api() {
  local max=${FF_API_WAIT:-600}
  FF_STEP="waiting for FreeFrame to start"
  say "Waiting for FreeFrame to finish starting (the first start prepares the database)..."
  if ! _ff_wait_for "$max" 5 _ff_logged dc exec -T api curl -fsS http://localhost:8000/health; then
    install_fail "FreeFrame did not finish starting within $(((max + 59) / 60)) minutes." \
      "see why with: sudo freeframe logs, then run sudo freeframe install again."
  fi
}

# Create the admin account through the API inside the compose network,
# before Traefik makes anything reachable from outside. The answers go as
# JSON on stdin, never on a command line, and the response (which holds
# sign-in tokens) is never logged.
_install_create_admin() {
  local json out code="" body="" detail
  FF_STEP="creating the admin account"
  json="{\"email\":$(_ff_json_str "$FF_ADMIN_EMAIL"),\"name\":$(_ff_json_str "$FF_ADMIN_NAME"),\"password\":$(_ff_json_str "$FF_ADMIN_PASSWORD")}"
  out=$(printf '%s' "$json" | dc exec -T api curl -sS -X POST -H 'Content-Type: application/json' \
    --data-binary @- -w '\n%{http_code}' http://localhost:8000/setup/create-superadmin 2>>"$FF_LOG") || true
  if [[ $out == *$'\n'* ]]; then
    code=${out##*$'\n'}
    body=${out%$'\n'*}
  fi
  case $code in
    201)
      FF_ADMIN_CREATED=1
      say "Admin account created for $FF_ADMIN_EMAIL."
      # Shown right away, on the terminal only: if a later step fails, a
      # re-run cannot create the account again (403), so this must not wait
      # for the closing summary.
      if [[ -n ${FF_PW_GENERATED:-} ]]; then _install_tell_password; fi
      ;;
    "" | 000)
      install_fail "FreeFrame's API could not be reached to create the admin account." \
        "the reason is at the end of $FF_LOG. Then run sudo freeframe install again."
      ;;
    403)
      FF_ADMIN_EXISTED=1
      say "An admin account already exists, so no new one was made. Sign in with the existing admin account."
      ;;
    429)
      install_fail "The admin account could not be created yet: FreeFrame allows only 3 tries in 10 minutes." \
        "wait 10 minutes, then run sudo freeframe install again."
      ;;
    *)
      detail=$(_ff_api_detail "$body")
      install_fail "The admin account could not be created${detail:+: $detail}." \
        "check the admin email and password, then run sudo freeframe install again."
      ;;
  esac
}

# _install_traefik_closed: make sure Traefik is not running before the admin
# account is created, so the setup endpoint is never reachable from outside.
# An earlier attempt may have left it running: stop it. Fails closed when
# that cannot be confirmed.
_install_traefik_closed() {
  local running
  FF_STEP="checking that FreeFrame is still closed to the outside"
  running=$(dc ps -q traefik 2>>"$FF_LOG") ||
    install_fail "Could not check whether FreeFrame's web entrance (Traefik) is running, so the installer stopped before creating the admin account." \
      "run sudo freeframe install again; the reason is at the end of the log."
  [[ -n $running ]] || return 0
  say "Closing FreeFrame to the outside until the admin account exists (an earlier attempt left it open)..."
  _ff_logged dc stop traefik || true
  running=$(dc ps -q traefik 2>>"$FF_LOG") || running=unknown
  if [[ -n $running ]]; then
    install_fail "FreeFrame's web entrance (Traefik) is still running, so the installer stopped before creating the admin account, to keep the setup page private." \
      "run: sudo docker compose --project-name freeframe stop traefik (in /opt/freeframe), then run sudo freeframe install again."
  fi
}

_install_start_step() {
  local out s
  local -a all=() svcs=()
  if [[ ${FF_SKIP_PULL:-} != 1 ]]; then
    FF_STEP="downloading FreeFrame"
    say "Downloading FreeFrame (about 2 GB; this can take a few minutes)..."
    if ! _ff_logged dc pull; then
      install_fail "FreeFrame could not be downloaded." "check that this server can reach ghcr.io, then run sudo freeframe install again."
    fi
  fi
  FF_STEP="starting FreeFrame"
  out=$(dc config --services 2>>"$FF_LOG") ||
    install_fail "The setup files could not be read." "run sudo freeframe install again; the reason is at the end of the log."
  mapfile -t all <<<"$out"
  for s in "${all[@]}"; do
    if [[ -n $s && $s != traefik ]]; then svcs+=("$s"); fi
  done
  # Fail closed: the first start must include the API and must not include
  # Traefik, whatever the downloaded compose files say.
  if ((${#svcs[@]} == 0)) || [[ " ${svcs[*]} " != *" api "* || " ${svcs[*]} " == *" traefik "* ]]; then
    install_fail "The downloaded setup files do not describe FreeFrame as expected (services: ${all[*]:-none})." \
      "run sudo freeframe install again to download them again. If it keeps happening, report it at https://github.com/Techiebutler/freeframe/issues"
  fi
  say "Starting FreeFrame (not reachable from outside yet)..."
  if ! _ff_logged dc up -d --no-build "${svcs[@]}"; then
    install_fail "FreeFrame could not be started." "run sudo freeframe install again; the reason is at the end of the log."
  fi
  FF_STATE="FreeFrame is running but cannot be reached from outside yet. Running sudo freeframe install again keeps your settings and continues from here."
  _install_wait_api
  _install_traefik_closed
  _install_create_admin
  FF_STEP="opening FreeFrame to the outside"
  if ! _ff_logged dc up -d --no-build traefik; then
    install_fail "FreeFrame's web entrance (Traefik) could not be started." "run sudo freeframe install again; the reason is at the end of the log."
  fi
  FF_STATE="FreeFrame is running. Running sudo freeframe install again keeps your settings and finishes the remaining checks."
}

_install_verify_step() {
  local file=$1 h ok=1 http_ip
  local -a hosts=()
  FF_STEP="checking that FreeFrame answers"
  say "Checking that FreeFrame answers at $(_ff_scheme "$FF_MODE")://$FF_HOST ..."
  if ! _ff_wait_for "${FF_HEALTH_WAIT:-300}" 5 probe_health "$FF_MODE" "$FF_HOST"; then
    install_fail "FreeFrame is running but does not answer on its web address." \
      "see why with: sudo freeframe logs, then run sudo freeframe install again."
  fi
  [[ $FF_MODE != off ]] || return 0
  FF_STEP="waiting for the HTTPS certificate"
  hosts=("$FF_HOST")
  if [[ $(env_get "$file" FREEFRAME_STORAGE) == bundled ]]; then hosts+=("storage.$FF_HOST"); fi
  say "Waiting for the HTTPS certificate from Let's Encrypt (usually under a minute)..."
  for h in "${hosts[@]}"; do
    if ! _ff_wait_for "${FF_CERT_WAIT:-300}" 10 cert_issued "$h"; then
      ok=0
      break
    fi
  done
  if ((ok)); then
    say "The certificate is in place."
    return 0
  fi
  if [[ $FF_MODE == sslip ]]; then
    warn "The certificate for the temporary address $h did not arrive in time. This happens when the free sslip.io service or Let's Encrypt is busy."
    FF_STEP="switching to plain HTTP"
    http_ip=$(_install_http_ip)
    if [[ -n ${FF_NAT:-} ]]; then
      say "This server reaches the internet through a router, so FreeFrame switches to plain HTTP on the server's own network address, http://$http_ip. It works from this network only."
    else
      say "Switching to plain HTTP on this server's IP address instead..."
    fi
    if ! switch_to_http_mode "$file" "$http_ip"; then
      install_fail "Could not switch to plain HTTP." "run sudo freeframe install again; the reason is at the end of the log."
    fi
    FF_MODE=off FF_HOST=$http_ip FF_FELL_BACK=1
    if ! _ff_wait_for "${FF_HEALTH_WAIT:-300}" 5 probe_health off "$http_ip"; then
      install_fail "FreeFrame does not answer on http://$http_ip." "see why with: sudo freeframe logs, then run sudo freeframe install again."
    fi
  else
    FF_CERT_PENDING=$h
  fi
}

# Nightly backups (spec goal 11), set up once FreeFrame runs and the admin
# exists. A failure stops before the install is marked complete, so a re-run
# finishes it.
_install_backup_timer_step() {
  FF_STEP="setting up the nightly backups"
  say "Setting up the nightly database backups..."
  if ! _ff_logged install_backup_timer; then
    install_fail "The nightly database backups could not be set up." \
      "run sudo freeframe install again; the reason is at the end of the log."
  fi
}

# _install_summary_lines WITH_PASSWORD: the closing message (spec goal 8).
# The generated password is only printed with WITH_PASSWORD=1 (the terminal),
# never into install.log.
_install_summary_lines() {
  local file=$1 with_pw=$2 root url origin
  root=$(ff_root)
  url="$(_ff_scheme "$FF_MODE")://$FF_HOST"
  say ""
  say "============================================================"
  if [[ -n ${FF_CERT_PENDING:-} ]]; then
    say "FreeFrame is running at $url, but its HTTPS certificate has not arrived yet."
  else
    say "FreeFrame is ready: $url"
  fi
  if [[ -n ${FF_ADMIN_EXISTED:-} ]]; then
    say "Sign in with the admin account that already existed."
  else
    say "Sign in as $FF_ADMIN_EMAIL"
    if [[ -n ${FF_PW_GENERATED:-} ]]; then
      if [[ $with_pw == 1 ]]; then
        say "Password: $FF_ADMIN_PASSWORD"
        say "(made for you and shown only this once: write it down now)"
      else
        say "Password: made for you and shown on the screen only, not in this log."
      fi
    fi
  fi
  say "============================================================"
  if [[ -n ${FF_CERT_PENDING:-} ]]; then
    say ""
    say "The HTTPS certificate for $FF_CERT_PENDING has not arrived yet, so browsers show a warning until it does."
    say "Check that the DNS records point at $FF_IP and that ports 80 and 443 are open to the internet,"
    say "then run: sudo freeframe restart"
  fi
  if [[ $FF_MODE == sslip ]]; then
    say ""
    say "This is a free temporary address. For production, use your own domain: sudo freeframe configure"
  fi
  if [[ -n ${FF_FELL_BACK:-} ]]; then
    say ""
    say "HTTPS could not be set up for the temporary address, so FreeFrame uses plain HTTP for now and"
    say "browsers mark it \"Not secure\". To use HTTPS, point a domain at this server and run: sudo freeframe configure"
  fi
  if [[ -z $(env_get "$file" SMTP_HOST) && $(env_get "$file" MAIL_PROVIDER) != ses ]]; then
    say ""
    say "Email is not set up. Without it, sign-in codes and invitation emails are not sent, and there is"
    say "no other way to recover a forgotten password. Invitation links can still be copied from the admin"
    say "page. To add email later, run: sudo freeframe configure"
  fi
  if [[ $FF_MODE == off && $(env_get "$file" FREEFRAME_STORAGE) == bundled ]]; then
    say ""
    say "Browsers upload footage to port 9000 on this server. If your provider has a firewall in front of"
    say "the server, open ports 80 and 9000 there."
  fi
  if [[ $(env_get "$file" S3_STORAGE) == s3 ]]; then
    origin=$url
    say ""
    say "Your AWS S3 bucket needs these CORS rules so browsers can upload to it (AWS does not get them"
    say "set automatically). In the AWS console: the bucket, Permissions, Cross-origin resource sharing (CORS):"
    say "[{\"AllowedOrigins\":[\"$origin\"],\"AllowedMethods\":[\"GET\",\"PUT\",\"POST\",\"HEAD\"],"
    say " \"AllowedHeaders\":[\"Content-Type\",\"Content-MD5\",\"x-amz-content-sha256\",\"x-amz-date\",\"x-amz-decoded-content-length\"],"
    say " \"ExposeHeaders\":[\"ETag\"],\"MaxAgeSeconds\":3000}]"
  fi
  say ""
  say "Settings:     $file (private: it holds the passwords; keep a copy somewhere safe)"
  say "Backups:      $root/backups (the database, every night at 3:00; the newest $FF_BACKUP_KEEP are kept)"
  say "Install log:  $root/install.log"
  say ""
  say "The backups are on this server only, so they do not survive losing it. Copy them somewhere"
  say "else now and then; the guide explains how: $FF_GUIDE_URL"
  say "Uploaded media is not in these backups."
  say ""
  say "Commands you will need:"
  say "  sudo freeframe status    see whether everything is running"
  say "  sudo freeframe update    move to the newest release"
  say "  sudo freeframe backup    save a copy of the database now"
}

_install_final_summary() {
  local file=$1
  _install_log_stop
  _install_summary_lines "$file" 1
  _install_summary_lines "$file" 0 >>"$FF_LOG" 2>&1
}

# cmd_install: `freeframe install` (spec goals 1 to 10).
cmd_install() {
  local root file
  root=$(ff_root)
  file="$root/.env.prod"
  FF_STATE="Nothing on this server has been changed yet."
  FF_LOG=""
  FF_STOPPED=()
  FF_ADDR_FROM_FILE="" FF_SMTP_FROM_FILE="" FF_ADMIN_EXISTED="" FF_CERT_PENDING="" FF_FELL_BACK=""
  FF_ADMIN_CREATED="" FF_PW_GENERATED="" FF_RERUN="the install command"
  FF_DONE=()

  # Refusals first: nothing is written before these pass.
  _install_check_system
  _install_check_foreign
  if [[ -f $file && -f $root/.installed ]]; then
    say "FreeFrame is already installed on this server, so nothing was changed."
    say "Its settings are in $file."
    say "To move to the newest release, run: sudo freeframe update"
    say "To change the web address, email or storage, run: sudo freeframe configure"
    return 0
  fi
  if [[ -z ${FF_YES:-} ]] && ! _ff_has_tty; then
    local example="sudo freeframe install --yes --admin-email you@yourstudio.com"
    _ff_cmd_installed || example=$(_ff_bootstrap_cmd --yes --admin-email you@yourstudio.com)
    _ff_stop 2 "There is no terminal here to answer the installer's questions." \
      "add --yes and give the answers ahead of time, for example: $example (to see every option, run: $(_ff_help_cmd))."
  fi

  _install_log_start
  FF_STATE="Nothing has been installed yet; the installer has only written its log."
  trap _install_on_error ERR
  install_preflight
  _install_questions "$file"

  # From here on the server is changed.
  _install_self
  _install_docker_step
  _install_swap_step
  _install_ufw_step
  _install_dns_step
  _install_fetch_step
  _install_settings_step "$file"
  _install_start_step
  _install_verify_step "$file"
  _install_backup_timer_step

  printf 'FreeFrame installed %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')" >"$root/.installed"
  trap - ERR
  _install_final_summary "$file"
}

# ------------------------------------------------------------
# Backups and restore (spec goals 11 and 13)
#
# A backup is two files in $FF_ROOT/backups: freeframe-<YYYYmmdd-HHMMSS>.dump
# (pg_dump -Fc of the database, written under a .partial name and renamed
# only when complete) and freeframe-<same stamp>.env.prod (a copy of the
# settings). Both are mode 600 in a 700 folder: they hold the passwords.
# backup_prune keeps the newest FF_BACKUP_KEEP by name. Media in the bucket
# is not part of a backup.
#
# backup and restore take a lock ($FF_ROOT/.freeframe.lock), so the nightly
# backup never runs in the middle of a restore.
# ------------------------------------------------------------

FF_BACKUP_KEEP=7

# _ff_q PATH: PATH in single quotes, for a command printed for the reader to
# copy and paste: a space or other special character in the path then
# cannot split or change it.
_ff_q() {
  local q="'\\''"
  printf "'%s'" "${1//\'/$q}"
}

# _ff_size_bytes FILE: the size of FILE in bytes.
_ff_size_bytes() { wc -c <"$1" | tr -d '[:space:]'; }

# _ff_human_size BYTES: 512 bytes, 2 KB, 12.4 MB, 3.0 GB.
_ff_human_size() {
  awk -v b="${1:-0}" 'BEGIN {
    if (b >= 1073741824) printf "%.1f GB", b / 1073741824
    else if (b >= 1048576) printf "%.1f MB", b / 1048576
    else if (b >= 1024) printf "%d KB", b / 1024
    else printf "%d bytes", b
  }'
}

# _ff_stamp: the time stamp in a backup's name.
_ff_stamp() { date +%Y%m%d-%H%M%S; }

# _ff_stamp_date NAME: "2026-10-26 03:04:12" for freeframe-20261026-030412.dump,
# nothing for a name without a stamp. The name, not the file's time, says
# when a backup was made: copying a file between servers changes its time.
_ff_stamp_date() {
  local re='freeframe-([0-9]{4})([0-9]{2})([0-9]{2})-([0-9]{2})([0-9]{2})([0-9]{2})\.dump$'
  [[ ${1:-} =~ $re ]] || return 0
  printf '%s-%s-%s %s:%s:%s' "${BASH_REMATCH[@]:1:6}"
}

# _ff_backup_dumps DIR: the backups in DIR, oldest first (name order), one
# path per line.
_ff_backup_dumps() {
  local f
  local LC_ALL=C
  for f in "$1"/freeframe-*.dump; do
    if [[ -f $f ]]; then printf '%s\n' "$f"; fi
  done
}

# _ff_is_pg_dump FILE: 0 when FILE is a pg_dump custom-format archive (it
# starts with PGDMP), which is what freeframe backup writes.
_ff_is_pg_dump() { [[ -r $1 && $(head -c 5 "$1" 2>/dev/null) == PGDMP ]]; }

# _ff_pg_names: FF_PG_USER and FF_PG_DB from .env.prod, with the defaults
# docker-compose.prod.yml and derive_env use.
_ff_pg_names() {
  local file
  file="$(ff_root)/.env.prod"
  FF_PG_USER=$(env_get "$file" POSTGRES_USER)
  FF_PG_DB=$(env_get "$file" POSTGRES_DB)
  FF_PG_USER=${FF_PG_USER:-freeframe}
  FF_PG_DB=${FF_PG_DB:-freeframe}
}

# _ff_need_root COMMAND / _ff_need_install: the refusals every command
# other than install shares.
_ff_need_root() {
  if ! ff_is_root; then
    _ff_stop 2 "Please run this as root." "put sudo in front of the command: sudo freeframe $1"
  fi
}

_ff_need_install() {
  local root
  root=$(ff_root)
  if [[ ! -f $root/.env.prod ]]; then
    _ff_stop 1 "FreeFrame is not installed on this server (there is no $root/.env.prod), so there is nothing to do." \
      "install it first: see $FF_GUIDE_URL"
  fi
}

# _ff_lock: take the backup/restore lock, without waiting. 1 when another
# backup or restore holds it. Without flock (not on a supported server) there
# is no lock.
# FF_BUSY: the start of the message when the lock is held. Any command
# that changes the server takes it, so it names them all.
FF_BUSY="Another freeframe command (an update, rollback, backup, restore, restart or configure) is running right now"

_ff_lock() {
  local root
  root=$(ff_root)
  command -v flock >/dev/null 2>&1 || return 0
  # Held already: by this process, or handed on by the update's re-exec
  # (the descriptor stays open across exec, and so does its lock).
  if [[ -n ${FF_LOCK_FD:-} ]] && flock -n "$FF_LOCK_FD" 2>/dev/null; then return 0; fi
  (umask 077 && : >>"$root/.freeframe.lock") || return 0
  exec {FF_LOCK_FD}>>"$root/.freeframe.lock"
  flock -n "$FF_LOCK_FD"
}

# _ff_lock_busy: 0 when another freeframe command holds the lock right now
# (status asks; it never keeps the lock).
_ff_lock_busy() {
  local f fd
  f="$(ff_root)/.freeframe.lock"
  command -v flock >/dev/null 2>&1 || return 1
  [[ -r $f ]] || return 1
  exec {fd}<"$f"
  if flock -n "$fd"; then
    flock -u "$fd"
    exec {fd}<&-
    return 1
  fi
  exec {fd}<&-
  return 0
}

# _ff_log_open COMMAND: write to install.log (mode 600) without copying the
# screen into it; for the nightly backup, whose own messages go to the
# journal.
_ff_log_open() {
  local root
  root=$(ff_root)
  FF_LOG="$root/install.log"
  if ! { (umask 077 && : >>"$FF_LOG") && chmod 600 "$FF_LOG"; }; then
    # No log (a full disk, say): the messages then do not mention one.
    FF_LOG=""
    return 0
  fi
  printf '\n===== freeframe %s, %s =====\n' "$1" "$(date '+%Y-%m-%d %H:%M:%S %z')" >>"$FF_LOG"
}

# _ff_backup_cleanup: remove what a backup that did not finish left behind.
_ff_backup_cleanup() {
  [[ -n ${FF_PARTIAL:-} ]] || return 0
  rm -f "$FF_PARTIAL.dump.partial" "$FF_PARTIAL.env.prod.partial"
  FF_PARTIAL=""
}

# _ff_log_lines LINE...: append LINEs to install.log, when the screen is not
# already copied into it (restore tees everything; backup does not). The
# lines are messages only, never a secret.
_ff_log_lines() {
  [[ -n ${FF_LOG:-} && -z ${FF_TERM_OUT:-} ]] || return 0
  printf '%s\n' "$@" >>"$FF_LOG" 2>/dev/null || true
}

# _ff_backup_refused LINE...: a backup that did not happen. Says so, and
# that the earlier backups are untouched, on the screen (or the journal) and
# in install.log.
_ff_backup_refused() {
  local line
  _ff_backup_cleanup
  # The log first, and a screen or journal that is gone (an ssh hangup, a
  # stopped journald) must not stop the rest, even under set -e.
  _ff_log_lines "$@" "No new backup was made; the earlier ones are untouched."
  for line in "$@"; do warn "$line" || true; done
  warn "No new backup was made; the earlier ones are untouched." || true
}

# backup_create prune|keep: save a backup of the database now (see the top of
# this section). Sets FF_BACKUP_MADE to the new .dump. With prune, only the
# newest FF_BACKUP_KEEP are kept afterwards; restore's safety copy uses keep,
# so it can never delete the backup being restored. Refuses when the disk has
# less free space than twice the last backup, or 1 GB. Prints its own
# message and returns 1 when no backup was made.
backup_create() {
  local mode=${1:-prune} root dir file base stamp last="" last_bytes=0 need free retry protect upd f
  local -a dumps=()
  root=$(ff_root)
  dir="$root/backups"
  file="$root/.env.prod"
  retry=${FF_RERUN:-sudo freeframe backup}
  FF_BACKUP_MADE="" FF_PARTIAL=""
  if ! { (umask 077 && mkdir -p "$dir") && chmod 700 "$dir"; }; then
    _ff_backup_refused "Cannot create the backups folder $dir." \
      "What to try: check that the disk is not full or read-only, then run: $retry"
    return 1
  fi
  # What a backup killed part-way (SIGKILL, power loss) left behind. Callers
  # hold the backup/restore lock, so no other backup is writing these.
  for f in "$dir"/freeframe-*.partial; do
    if [[ -e $f ]]; then
      rm -f -- "$f"
      printf 'backup: removed %s, left by a backup that did not finish\n' "$f" >>"${FF_LOG:-/dev/null}"
    fi
  done

  # The copy an unfinished restore can be undone with is kept out of the
  # size rule and out of pruning while it is recorded.
  protect=$(_restore_undo_path)
  upd=""
  if _update_undo_read; then upd=$FF_UNDO_BACKUP; fi
  mapfile -t dumps < <(_ff_backup_dumps "$dir")
  for f in ${dumps[@]+"${dumps[@]}"}; do
    if [[ $f != "$protect" && $f != "$upd" ]]; then last=$f; fi
  done
  if [[ -n $last ]]; then
    last_bytes=$(_ff_size_bytes "$last") || last_bytes=0
    [[ $last_bytes =~ ^[0-9]+$ ]] || last_bytes=0
  fi
  need=$(((2 * last_bytes + 1048575) / 1048576))
  ((need >= 1024)) || need=1024
  free=$(_ff_free_mb "$root") || free=""
  if [[ ! $free =~ ^[0-9]+$ ]]; then
    _ff_backup_refused "Could not check the free disk space under $root, so no backup was made." \
      "What to try: check the disk (df -h $(_ff_q "$root")), then run: $retry"
    return 1
  fi
  if ((free < need)); then
    _ff_backup_refused "There is not enough free disk space for a backup: $free MB free under $root, and a backup needs at least $need MB there (twice the size of the last backup, and never less than 1 GB)." \
      "What to try: make room on the disk, for example by copying older backups from $dir to another computer and deleting them here, then run: $retry"
    return 1
  fi

  _ff_pg_names
  # The nightly timer catches up at boot (Persistent=true), possibly before
  # Docker has started the database: give it a minute.
  if ! _ff_wait_for "${FF_BACKUP_DB_WAIT:-60}" 5 _ff_logged dc exec -T postgres pg_isready -U "$FF_PG_USER"; then
    _ff_backup_refused "FreeFrame's database is not running, so no backup was made." \
      "What to try: start FreeFrame (sudo freeframe restart), then run: $retry"
    return 1
  fi
  stamp=$(_ff_stamp) || stamp=""
  while [[ $stamp =~ ^[0-9]{8}-[0-9]{6}$ ]] &&
    [[ -e $dir/freeframe-$stamp.dump || -e $dir/freeframe-$stamp.env.prod ]]; do
    sleep 1
    stamp=$(_ff_stamp) || stamp=""
  done
  if [[ ! $stamp =~ ^[0-9]{8}-[0-9]{6}$ ]]; then
    _ff_backup_refused "The backup could not be named: the server's date ('$stamp') is not usable." \
      "What to try: check the date with: date, then run: $retry"
    return 1
  fi
  base="$dir/freeframe-$stamp"
  FF_PARTIAL=$base
  printf 'backup: writing %s.dump\n' "$base" >>"${FF_LOG:-/dev/null}"
  if ! (umask 077 && dc exec -T postgres pg_dump -Fc -U "$FF_PG_USER" "$FF_PG_DB" \
    >"$base.dump.partial" 2>>"${FF_LOG:-/dev/null}"); then
    _ff_backup_refused "The database could not be backed up: FreeFrame's database did not answer, or the copy stopped part-way." \
      "What to try: check that FreeFrame's database is running (sudo freeframe status), then run: $retry.${FF_LOG:+ The reason is at the end of $FF_LOG.}"
    return 1
  fi
  if ! _ff_is_pg_dump "$base.dump.partial"; then
    _ff_backup_refused "The database could not be backed up: what came back is not a database copy." \
      "What to try: run: $retry.${FF_LOG:+ The reason is at the end of $FF_LOG.}"
    return 1
  fi
  if ! { (umask 077 && cp "$file" "$base.env.prod.partial") && chmod 600 "$base.env.prod.partial"; }; then
    _ff_backup_refused "The settings could not be copied next to the backup." \
      "What to try: check that the disk is not full, then run: $retry"
    return 1
  fi
  # The settings copy first: a .dump that exists always has its settings.
  if ! { mv -f "$base.env.prod.partial" "$base.env.prod" && mv -f "$base.dump.partial" "$base.dump"; }; then
    rm -f "$base.env.prod"
    _ff_backup_refused "The backup could not be saved under its final name in $dir." \
      "What to try: check that the disk is not full, then run: $retry"
    return 1
  fi
  FF_PARTIAL=""
  FF_BACKUP_MADE="$base.dump"
  printf 'backup: saved %s.dump (%s)\n' "$base" "$(_ff_human_size "$(_ff_size_bytes "$base.dump")")" >>"${FF_LOG:-/dev/null}"
  if [[ $mode == prune ]] && ! backup_prune "$dir" "$FF_BACKUP_KEEP" "$protect" "$upd"; then
    warn "The backup was saved, but older backups could not be cleared away."
  fi
  return 0
}

# _backup_on_signal SIG: Ctrl-C, systemctl stop or a shutdown during a
# backup. The part-written files are removed (and a SIGKILL's are removed by
# the next backup).
_backup_on_signal() {
  # PIPE too: a write to a vanished reader then fails instead of killing.
  trap '' INT TERM HUP PIPE
  # To the saved stderr: a trap runs inside the redirection of the command
  # it interrupted.
  _ff_backup_refused "The backup was stopped (SIG$1) before it finished." 2>&"${FF_BACKUP_ERR:-2}"
  exit 1
}

# cmd_backup: `freeframe backup [--quiet]`. --quiet (the nightly timer)
# prints nothing when the backup is saved, and a plain error when not.
cmd_backup() {
  local root base size
  root=$(ff_root)
  if ((${#FF_ARGS[@]})); then
    _ff_bad_usage "freeframe backup takes no file name: backups always go to $root/backups."
  fi
  _ff_need_root backup
  _ff_need_install
  FF_ACTOR="the backup"
  _ff_log_open backup
  if ! _ff_lock; then
    _ff_log_lines "$FF_BUSY, so this backup did not start."
    _ff_stop 1 "$FF_BUSY, so this backup did not start." \
      "wait a few minutes for it to finish, then run sudo freeframe backup again."
  fi
  exec {FF_BACKUP_ERR}>&2
  # No ERR trap: backup_create runs inside `if !`, where bash never fires
  # one, so every step in it is checked explicitly instead.
  trap '_backup_on_signal INT' INT
  trap '_backup_on_signal TERM' TERM
  trap '_backup_on_signal HUP' HUP
  if ! backup_create prune; then exit 1; fi
  trap - INT TERM HUP
  [[ -z ${FF_QUIET:-} ]] || return 0
  base=${FF_BACKUP_MADE%.dump}
  size=$(_ff_human_size "$(_ff_size_bytes "$FF_BACKUP_MADE")")
  say "Saved a backup of the database: $FF_BACKUP_MADE ($size),"
  say "with a copy of the settings next to it: ${base##*/}.env.prod"
  say "The newest $FF_BACKUP_KEEP backups are kept, and one is made every night at 3:00."
  say "They are on this server only, so they do not survive losing it: copy them somewhere else"
  say "now and then (the guide explains how: $FF_GUIDE_URL). Uploaded media is not in them."
}

# restore_list: the backups on this server, newest first, with dates and sizes.
restore_list() {
  local dir f name when i undo
  local -a dumps=()
  dir="$(ff_root)/backups"
  mapfile -t dumps < <(_ff_backup_dumps "$dir")
  if ((${#dumps[@]} == 0)); then
    say "There are no backups in $dir yet."
    say "To make one now, run: sudo freeframe backup"
    return 0
  fi
  say "Backups on this server, newest first:"
  for ((i = ${#dumps[@]} - 1; i >= 0; i--)); do
    f=${dumps[i]}
    name=${f##*/}
    when=$(_ff_stamp_date "$name")
    printf '  %-34s  %-19s  %s\n' "$name" "${when:-(no date)}" "$(_ff_human_size "$(_ff_size_bytes "$f")")"
  done
  say ""
  say "To put one back, run for example (this replaces the current database, after saving a copy of it):"
  say "  sudo freeframe restore $(_ff_q "${dumps[-1]}")"
  say "A backup copied from another server can be given by its path."
  undo=$(_restore_undo_path)
  if [[ -n $undo ]]; then
    say ""
    say "A restore did not finish. The copy of the database from before it is kept: $undo"
    say "To go back to it, run: sudo freeframe restore --yes $(_ff_q "$undo")"
  fi
}

# _restore_resolve ARG: the full path of the backup ARG names: a path, or a
# name in the backups folder. Stops when there is no such backup.
_restore_resolve() {
  local arg=$1 root path=""
  root=$(ff_root)
  if [[ -f $arg ]]; then
    path=$arg
  elif [[ $arg != */* && -f $root/backups/$arg ]]; then
    path="$root/backups/$arg"
  else
    _ff_stop 1 "There is no backup file '$arg', so nothing was changed." \
      "run sudo freeframe restore with no file name to see the backups on this server."
  fi
  if [[ $path != /* ]]; then path="$(cd "$(dirname "$path")" && pwd)/${path##*/}"; fi
  if ! _ff_is_pg_dump "$path"; then
    _ff_stop 1 "'$path' is not a FreeFrame database backup (one made by freeframe backup), so nothing was changed." \
      "pick one of the backups listed by: sudo freeframe restore. A .sql.gz backup from a manual setup is restored by hand, as the guide explains: $FF_GUIDE_URL"
  fi
  FF_RESTORE_FILE=$path
}

# The undo record ($FF_ROOT/.restore-undo, mode 600): the path of the safety
# copy taken by a restore whose database may now be empty or gone. A retry
# over an absent or empty database keeps pointing at it instead of copying
# that empty database; over a database with data a retry takes a fresh copy,
# which replaces the record. backup_create keeps the recorded copy out of
# pruning and the size rule. Cleared as soon as pg_restore succeeds (the
# database is whole again), and when the run that wrote it stops before the
# drop began.
_restore_undo_file() { printf '%s/.restore-undo' "$(ff_root)"; }

# _restore_undo_path: the recorded safety copy, when it still exists.
_restore_undo_path() {
  local f p=""
  f=$(_restore_undo_file)
  [[ -f $f ]] || return 0
  IFS= read -r p <"$f" || true
  if [[ -n $p && -f $p ]]; then printf '%s' "$p"; fi
  return 0
}

_restore_undo_set() {
  local f
  f=$(_restore_undo_file)
  (umask 077 && printf '%s\n' "$1" >"$f.tmp") && chmod 600 "$f.tmp" && mv -f "$f.tmp" "$f"
}

_restore_undo_clear() { rm -f "$(_restore_undo_file)"; }

# _restore_forget_new_record: this run recorded its own copy, then stopped
# before dropping the database. The database still has its data, so the
# record would only mislead a later restore.
_restore_forget_new_record() {
  if [[ -n ${FF_RECORD_NEW:-} && -z ${FF_DROP_STARTED:-} ]]; then _restore_undo_clear; fi
  return 0
}

# _restore_db_state: what is in FreeFrame's database now, asked through the
# maintenance database: absent, empty (no tables, as a failed restore leaves
# it) or data. Fails (1) when that cannot be found out.
_restore_db_state() {
  local n
  n=$(printf "SELECT count(*) FROM pg_database WHERE datname = :'db';\n" |
    dc exec -T postgres psql -U "$FF_PG_USER" -d postgres -v db="$FF_PG_DB" -Atq 2>>"${FF_LOG:-/dev/null}") || return 1
  case $n in
    0)
      printf 'absent'
      return 0
      ;;
    1) ;;
    *) return 1 ;;
  esac
  n=$(dc exec -T postgres psql -U "$FF_PG_USER" -d "$FF_PG_DB" -Atqc \
    "SELECT count(*) FROM pg_tables WHERE schemaname NOT IN ('pg_catalog', 'information_schema')" \
    2>>"${FF_LOG:-/dev/null}") || return 1
  [[ $n =~ ^[0-9]+$ ]] || return 1
  if ((n == 0)); then printf 'empty'; else printf 'data'; fi
}

# _restore_fail STATE MESSAGE WHAT_TO_TRY: a step failed; STATE says where
# that leaves the database and FreeFrame.
_restore_fail() {
  FF_STATE=$1
  if [[ -n ${FF_RESTORE_NO_START:-} ]]; then
    # Within a rollback the setup files and the version were changed
    # already (FF_STATE_PREFIX says so); only the database was not.
    local msg=${2//nothing was changed/the database was not changed}
    install_fail "${msg//before changing anything/before changing the database}" "$3"
  fi
  install_fail "$2" "$3"
}

# _restore_start_hint: how to get FreeFrame going after a restore stopped
# before the drop: restart, unless an earlier restore that did not finish
# left the database possibly empty (restart refuses then, and starting
# FreeFrame would open its setup page): then finish or undo that restore.
_restore_start_hint() {
  local undo
  # A rollback's own state line says what to do (FF_STATE_PREFIX).
  [[ -z ${FF_RESTORE_NO_START:-} ]] || return 0
  undo=$(_restore_undo_path)
  if [[ -z $undo ]]; then
    printf 'To start FreeFrame again as it was, run: sudo freeframe restart'
    return 0
  fi
  printf 'FreeFrame stays stopped: an earlier restore did not finish, so the database may be empty. To finish, run: %s' "$FF_RERUN"
  if [[ $undo != "${FF_RESTORE_FILE:-}" ]]; then
    printf '. To go back to the data as it was before that restore instead, run: sudo freeframe restore --yes %s' "$(_ff_q "$undo")"
  fi
}

# _restore_restart: start FreeFrame again after a step that changed nothing
# failed, and print the sentence that says whether that worked. While an
# earlier restore's undo record stands it starts nothing and says why.
_restore_restart() {
  # Rollback: the old version must not start on the database the update
  # left, so nothing is started (FF_STATE_PREFIX says what to do).
  [[ -z ${FF_RESTORE_NO_START:-} ]] || return 0
  if [[ -n $(_restore_undo_path) ]]; then
    _restore_start_hint
    return 0
  fi
  if _ff_logged dc up -d --no-build; then
    printf 'FreeFrame has been started again.'
  else
    printf 'FreeFrame could not be started again. To start it, run: sudo freeframe restart'
  fi
}

_restore_on_error() {
  local code=$?
  if ((BASH_SUBSHELL > 0)); then exit "$code"; fi
  trap - ERR
  _ff_backup_cleanup
  _restore_forget_new_record
  _restore_report "The restore stopped unexpectedly while ${FF_STEP:-restoring} (error $code)." \
    "look at the end of ${FF_LOG:-the output above} for the reason."
}

# _restore_report MESSAGE WHAT_TO_TRY: install_fail for the restore's traps.
# A trap runs inside the redirection of the command it interrupted (often
# `_ff_logged ...`, which writes to the log only), so the lines go through a
# pipe of their own to the terminal and the log, then the restore exits 1.
_restore_report() {
  if [[ -z ${FF_TERM_ERR:-} ]]; then install_fail "$1" "$2"; fi
  (
    FF_TERM_OUT=""
    install_fail "$1" "$2"
  ) 2>&1 | tee -a "${FF_LOG:-/dev/null}" >&"$FF_TERM_ERR" || true
  exit 1
}

# _restore_on_signal SIG: Ctrl-C, a closed terminal or a shutdown during a
# restore. Says what state the database is in and how to go on, like any
# other stop.
_restore_on_signal() {
  trap '' INT TERM HUP
  trap - ERR
  _ff_backup_cleanup
  _restore_forget_new_record
  _restore_report "The restore was stopped (SIG$1) while ${FF_STEP:-restoring}, before it finished." \
    "to finish it, run: $FF_RERUN"
}

# cmd_restore: `freeframe restore [FILE]` (spec goal 13). With no FILE it
# lists the backups. With FILE it asks first (unless --yes), stops every
# service except postgres and traefik, saves a safety copy of the current
# database as a normal backup, recreates the database, restores FILE into it
# with pg_restore --no-owner --no-acl in one transaction (so a backup from a
# server with another database user restores too), and starts FreeFrame
# again.
# If a step after the drop fails, FreeFrame stays stopped (on an empty
# database its setup page would be open to anyone) and the message says what
# state the database is in and the command that tries again.
cmd_restore() {
  local root dump when undo undo_cmd
  root=$(ff_root)
  if ((${#FF_ARGS[@]} > 1)); then
    _ff_bad_usage "freeframe restore takes one backup file, for example: sudo freeframe restore $(_ff_q "$root/backups/freeframe-20261026-030000.dump")"
  fi
  _ff_need_root restore
  _ff_need_install
  if ((${#FF_ARGS[@]} == 0)); then
    restore_list
    return 0
  fi
  _restore_resolve "${FF_ARGS[0]}"
  dump=$FF_RESTORE_FILE
  when=$(_ff_stamp_date "${dump##*/}")

  if [[ -z ${FF_YES:-} ]]; then
    if ! _ff_has_tty; then
      _ff_stop 2 "Restoring replaces everything in FreeFrame's database, so it needs a yes, and there is no terminal here to ask." \
        "run it in a terminal, or add --yes: sudo freeframe restore --yes $(_ff_q "$dump")"
    fi
    say "This replaces everything in FreeFrame's database with the backup${when:+ made $when}:"
    say "  $dump"
    say "Projects, comments, people and share links added or changed since then will be gone."
    say "A copy of the current database is saved first, so this can be undone. Uploaded media"
    say "files are not in the backup and stay as they are. FreeFrame is stopped while this runs."
    if ! confirm "Restore this backup now?" N; then
      say "Restore cancelled. Nothing was changed."
      exit 1
    fi
  fi

  if ! _ff_lock; then
    _ff_stop 1 "$FF_BUSY, so this restore did not start. Nothing was changed." \
      "wait a few minutes for it to finish, then run the command again."
  fi
  FF_ACTOR="the restore"
  FF_STOPPED=()
  FF_ADMIN_CREATED="" FF_PW_GENERATED=""
  FF_RERUN="sudo freeframe restore --yes $(_ff_q "$dump")"
  FF_STATE="Nothing has been changed."
  FF_RECORD_NEW="" FF_DROP_STARTED="" FF_RESTORE_NO_START="" FF_STATE_PREFIX=""
  _install_log_start restore
  trap _restore_on_error ERR
  trap '_restore_on_signal INT' INT
  trap '_restore_on_signal TERM' TERM
  trap '_restore_on_signal HUP' HUP
  restore_database "$dump"
  undo=$FF_RESTORE_UNDO undo_cmd=$FF_RESTORE_UNDO_CMD

  FF_STATE="The backup has been put back${undo:+ (the database as it was before is saved; to go back to it, run: $undo_cmd)}."
  FF_STEP="starting FreeFrame again"
  say "Starting FreeFrame again..."
  if ! _ff_logged dc up -d --no-build; then
    install_fail "The backup has been put back, but FreeFrame could not be started again." \
      "see why with: sudo freeframe logs, then run: sudo freeframe restart"
  fi
  if ! _ff_wait_for "${FF_API_WAIT:-600}" 5 _ff_logged dc exec -T api curl -fsS http://localhost:8000/health; then
    install_fail "The backup has been put back, but FreeFrame did not finish starting within $(((${FF_API_WAIT:-600} + 59) / 60)) minutes." \
      "see why with: sudo freeframe logs, then run: sudo freeframe restart"
  fi
  trap - ERR INT TERM HUP
  say ""
  say "The database is back as it was in $dump${when:+ (made $when)}."
  if [[ -n $undo ]]; then say "The database as it was before is saved; to go back to it, run: $undo_cmd"; fi
  _install_log_stop
}

# restore_database DUMP: put DUMP back as FreeFrame's database (spec goal
# 13). The caller holds the lock, logs and sets the traps, FF_RERUN (the
# command that tries again) and FF_RESTORE_FILE. Stops every service except
# postgres and traefik, saves a safety copy when the database has data
# (recorded in .restore-undo while the database may be empty), drops and
# recreates the database and restores DUMP in one transaction. FreeFrame is
# not started: the caller does that. An early failure starts FreeFrame again
# as it was, unless FF_RESTORE_NO_START (rollback: the old version must not
# start on the database the update left) or an earlier restore is
# unfinished. Sets FF_RESTORE_UNDO / FF_RESTORE_UNDO_CMD to the way back.
restore_database() {
  local root dump=$1 out s state recorded="" undo="" undo_cmd=""
  local -a all=() svcs=()
  root=$(ff_root)
  FF_RESTORE_UNDO="" FF_RESTORE_UNDO_CMD=""
  _ff_pg_names
  recorded=$(_restore_undo_path)
  if [[ -z $recorded && -f $(_restore_undo_file) ]]; then
    warn "The copy recorded by an earlier restore that did not finish is no longer there, so it cannot be used to undo."
    _restore_undo_clear
  fi

  FF_STEP="starting the database"
  say "Restoring the database from $dump"
  if ! _ff_logged dc up -d --no-build postgres ||
    ! _ff_wait_for "${FF_DB_WAIT:-120}" 2 _ff_logged dc exec -T postgres pg_isready -U "$FF_PG_USER"; then
    _restore_fail "" "FreeFrame's database did not start, so nothing was changed." \
      "see why with: sudo freeframe logs postgres, then run: $FF_RERUN"
  fi

  FF_STEP="stopping FreeFrame"
  out=$(dc config --services 2>>"$FF_LOG") ||
    _restore_fail "" "The setup files in $root could not be read, so nothing was changed." \
      "run: $FF_RERUN. The reason is at the end of the log."
  mapfile -t all <<<"$out"
  for s in "${all[@]}"; do
    if [[ -n $s && $s != postgres && $s != traefik ]]; then svcs+=("$s"); fi
  done
  say "Stopping FreeFrame (its web address shows an error until the restore is done)..."
  FF_STATE="FreeFrame may be partly stopped; the database has not been changed. $(_restore_start_hint)"
  if ((${#svcs[@]})) && ! _ff_logged dc stop "${svcs[@]}"; then
    _restore_fail "$(_restore_restart)" "FreeFrame could not be stopped, so nothing was changed." \
      "run: $FF_RERUN. The reason is at the end of the log."
  fi
  FF_STATE="FreeFrame is stopped and the database has not been changed. $(_restore_start_hint)"

  # Whether a copy is needed is asked through the maintenance database: an
  # absent or empty database has nothing to save, and one that exists but
  # cannot be checked is never dropped without a copy.
  FF_STEP="checking the current database"
  if ! state=$(_restore_db_state); then
    _restore_fail "$(_restore_restart)" "The current database could not be checked, so the restore stopped before changing anything (it will not replace a database it cannot copy first)." \
      "the reason is at the end of $FF_LOG. Then run: $FF_RERUN"
  fi
  FF_STEP="saving a copy of the current database"
  if [[ $state == data ]]; then
    say "Saving a copy of the current database first..."
    if ! backup_create keep; then
      _restore_fail "$(_restore_restart)" "No copy of the current database could be saved, so the restore stopped before changing anything." \
        "fix what the message above says, then run: $FF_RERUN"
    fi
    # The database has data, so this copy is the way back: it replaces any
    # record left by an earlier restore (whose database is no longer the
    # one there now). Flagged first: a signal while it is written must
    # still drop it.
    FF_RECORD_NEW=1
    if ! _restore_undo_set "$FF_BACKUP_MADE"; then
      _restore_fail "$(_restore_restart)" "The copy of the current database ($FF_BACKUP_MADE) could not be recorded, so the restore stopped before changing anything." \
        "check that the disk is not full, then run: $FF_RERUN"
    fi
    say "Saved the current database as $FF_BACKUP_MADE"
    if [[ -n $recorded && $recorded != "$dump" ]]; then
      say "An earlier restore had not finished; its copy ($recorded) is an ordinary backup again."
    fi
    recorded=$FF_BACKUP_MADE
  elif [[ -n $recorded ]]; then
    say "The database is empty after an earlier restore that did not finish, so there is nothing new to save."
    say "The copy from before that restore is kept: $recorded"
  else
    say "The current database is empty or not there, so there is nothing to save before the restore."
  fi
  # Restoring the recorded copy itself is the undo: then there is nothing
  # further to go back to. A rollback offers none: the copy holds what the
  # update left, which the old version must not start on.
  if [[ -n $recorded && $recorded != "$dump" && -z ${FF_RESTORE_NO_START:-} ]]; then
    undo=$recorded
    undo_cmd="sudo freeframe restore --yes $(_ff_q "$undo")"
  fi

  FF_STEP="removing the current database"
  say "Replacing the database with the backup..."
  FF_DROP_STARTED=1
  FF_STATE="The database may already have been removed. FreeFrame is stopped, so nothing can write to it. To try again, run: $FF_RERUN${undo:+. To go back to the data as it was before this restore instead, run: $undo_cmd}"
  if ! _ff_logged dc exec -T postgres dropdb -U "$FF_PG_USER" --if-exists --force "$FF_PG_DB"; then
    # DROP DATABASE either happens or not, but dropdb can fail after it did
    # (a broken connection), so ask what is there now instead of assuming.
    state=$(_restore_db_state) || state=unknown
    if [[ $state == data ]]; then
      FF_DROP_STARTED=""
      _restore_forget_new_record
      _restore_fail "$(_restore_restart)" "The current database could not be removed, so it is unchanged." \
        "the reason is at the end of $FF_LOG. Then run: $FF_RERUN"
    fi
    # Possibly gone: keep the record and keep FreeFrame stopped (on an empty
    # database its setup page would be open to anyone).
    install_fail "The current database could not be replaced, and it may already have been removed." \
      "the reason is at the end of $FF_LOG."
  fi
  FF_STATE="The database has been removed and is not back yet. FreeFrame is stopped, so nothing can write to it. To try again, run: $FF_RERUN${undo:+. To go back to the data as it was before this restore instead, run: $undo_cmd}"
  FF_STEP="creating the database again"
  if ! _ff_logged dc exec -T postgres createdb -U "$FF_PG_USER" -O "$FF_PG_USER" "$FF_PG_DB"; then
    install_fail "The database could not be created again." "the reason is at the end of $FF_LOG."
  fi
  FF_STATE="The database is empty now and FreeFrame is stopped, so nothing can write to it. To try again, run: $FF_RERUN${undo:+. To go back to the data as it was before this restore instead, run: $undo_cmd}"
  FF_STEP="putting the backup back"
  if ! _ff_logged dc exec -T postgres pg_restore -U "$FF_PG_USER" -d "$FF_PG_DB" --no-owner --no-acl --single-transaction <"$dump"; then
    _restore_fail "The database is empty now: the backup goes back in one piece or not at all, so nothing from it was half applied. FreeFrame is stopped, so nothing can write to it. To try again, run: $FF_RERUN${undo:+. To go back to the data as it was before this restore instead, run: $undo_cmd}" \
      "The backup could not be put back into the database." "the reason is at the end of $FF_LOG."
  fi
  # The database is whole again: the record has done its job. The messages
  # below still name this run's copy as the way back.
  _restore_undo_clear
  FF_RESTORE_UNDO=$undo FF_RESTORE_UNDO_CMD=$undo_cmd
}

# ------------------------------------------------------------
# Shared by update, configure, status, logs and restart
# ------------------------------------------------------------

# _ff_version_in TEXT: the version an images compose file runs by default
# (1.21.0 for ${FREEFRAME_VERSION:-1.21.0}).
_ff_version_in() {
  local re='\$\{FREEFRAME_VERSION:-([^}]+)\}'
  [[ $1 =~ $re ]] || return 1
  printf '%s' "${BASH_REMATCH[1]}"
}

# ff_version: the version FreeFrame on this server runs (from its next start
# on): FREEFRAME_VERSION in .env.prod when it is pinned there, otherwise the
# default in the images compose file. "unknown" when neither says.
ff_version() {
  local root v="" f
  root=$(ff_root)
  v=$(env_get "$root/.env.prod" FREEFRAME_VERSION)
  f="$root/docker-compose.images.yml"
  if [[ -z $v && -f $f ]]; then v=$(_ff_version_in "$(<"$f")") || v=""; fi
  printf '%s' "${v:-unknown}"
}

# _ff_version_gt A B: 0 when version A is newer than B. A leading v is
# ignored; the dotted numbers compare as numbers (1.10.0 > 1.9.3); a
# pre-release ranks below its release (1.22.0-rc1 < 1.22.0), and two
# pre-releases compare part by part (rc.10 > rc.9), as in semantic versioning.
_ff_version_gt() {
  local a=${1#v} b=${2#v} ca cb pa="" pb="" r=0
  ca=${a%%-*} cb=${b%%-*}
  [[ $a != *-* ]] || pa=${a#*-}
  [[ $b != *-* ]] || pb=${b#*-}
  _ff_parts_cmp "$ca" "$cb" 0 || r=$?
  case $r in
    0) return 0 ;;
    1) return 1 ;;
  esac
  # Same release: no pre-release is newer than any pre-release.
  if [[ -z $pa && -z $pb ]]; then return 1; fi
  if [[ -z $pa ]]; then return 0; fi
  if [[ -z $pb ]]; then return 1; fi
  r=0
  _ff_parts_cmp "$pa" "$pb" 1 || r=$?
  ((r == 0))
}

# _ff_parts_cmp A B PRE: compare dot-separated parts: 0 when A is newer, 1
# when older, 2 when equal. Numbers compare as numbers, anything else as
# text. Missing parts count as 0, or (PRE=1, pre-release labels) as older.
_ff_parts_cmp() {
  local i x y
  local -a pa=() pb=()
  # Text parts compare byte by byte, the same on every server language.
  local LC_ALL=C
  IFS=. read -ra pa <<<"$1"
  IFS=. read -ra pb <<<"$2"
  for ((i = 0; i < ${#pa[@]} || i < ${#pb[@]}; i++)); do
    if ((i >= ${#pa[@]})) && [[ $3 == 1 ]]; then return 1; fi
    if ((i >= ${#pb[@]})) && [[ $3 == 1 ]]; then return 0; fi
    x=${pa[i]:-0} y=${pb[i]:-0}
    if [[ $x =~ ^[0-9]+$ && $y =~ ^[0-9]+$ ]]; then
      ((10#$x == 10#$y)) && continue
      if ((10#$x > 10#$y)); then return 0; fi
      return 1
    fi
    [[ $x == "$y" ]] && continue
    if [[ $x > $y ]]; then return 0; fi
    return 1
  done
  return 2
}

# remote_version CHANNEL: the version `freeframe update` would move to: the
# default in the images compose file at the channel's ref. Fails without a
# network answer.
remote_version() {
  local out
  out=$(curl -fsSL --max-time 10 "$FF_RAW_BASE/$1/docker-compose.images.yml" 2>/dev/null) || return 1
  _ff_version_in "$out"
}

# cert_expiry HOST: when the certificate Traefik serves for HOST ends. Fails
# when there is none, or only Traefik's own self-signed one.
cert_expiry() {
  local host=$1 out
  out=$({ timeout 20 openssl s_client -connect 127.0.0.1:443 -servername "$host" </dev/null 2>/dev/null || true; } |
    openssl x509 -noout -issuer -enddate 2>/dev/null) || return 1
  [[ $out == *notAfter=* && $out != *"TRAEFIK DEFAULT CERT"* ]] || return 1
  printf '%s\n' "${out##*notAfter=}"
}

# _ff_url_host URL: the host part of a web address.
_ff_url_host() {
  local h=${1#*://}
  h=${h%%/*}
  printf '%s' "${h%%:*}"
}

# _ff_need_finished_install COMMAND: these commands start FreeFrame, Traefik
# included. Before install has created the admin account that would open the
# setup page to anyone, so they wait for install to finish.
_ff_need_finished_install() {
  if [[ ! -f $(ff_root)/.installed ]]; then
    _ff_stop 1 "The install of FreeFrame did not finish on this server, so freeframe $1 did not run." \
      "run sudo freeframe install again: it keeps your settings and continues where it stopped."
  fi
}

# _ff_refuse_unfinished_restore COMMAND [logged]: while a restore's undo record
# stands, the database may be empty; FreeFrame started on it would offer its
# setup page to anyone. The record is left as it is. Checked under the lock:
# a restore that is running has the same record, and holds the lock.
_ff_refuse_unfinished_restore() {
  local undo msg try
  undo=$(_restore_undo_path)
  [[ -n $undo ]] || return 0
  msg="A restore of the database did not finish, so the database may be empty. Starting FreeFrame on it would open its setup page to anyone, so freeframe $1 did not run."
  try="finish the restore by running it again, or go back to the database as it was before it: sudo freeframe restore --yes $(_ff_q "$undo")"
  if [[ -f $(_update_undo_file) ]]; then
    try="finish the rollback, which is safe to run again: sudo freeframe rollback"
  fi
  # logged: the screen is copied into install.log, so the end goes through it.
  if [[ ${2:-} == logged ]]; then install_fail "$msg" "$try"; fi
  _ff_log_lines "$msg" "What to try: $try"
  _ff_stop 1 "$msg" "$try"
}

# _ff_wait_healthy MODE HOST: wait for the API inside the compose network,
# then for an answer through Traefik on the web address.
_ff_wait_healthy() {
  _ff_wait_for "${FF_API_WAIT:-600}" 5 _ff_logged dc exec -T api curl -fsS http://localhost:8000/health &&
    _ff_wait_for "${FF_HEALTH_WAIT:-300}" 5 probe_health "$1" "$2"
}

# _ff_cmd_on_error / _ff_cmd_on_signal SIG: the traps of update and
# configure: say in plain words what stopped and the state it left.
_ff_cmd_on_error() {
  local code=$?
  if ((BASH_SUBSHELL > 0)); then exit "$code"; fi
  trap - ERR
  _ff_backup_cleanup
  _restore_forget_new_record
  rm -rf "$(ff_root)"/.download.??????
  if [[ ${FF_UPDATE_PHASE:-} == saved ]]; then _update_undo_change "$FF_UPDATE_OLD" || true; fi
  _restore_report "The ${FF_CMD:-command} stopped unexpectedly while ${FF_STEP:-working} (error $code)." \
    "${FF_TRAP_HINT:-look at the end of ${FF_LOG:-the output above} for the reason.}"
}

_ff_cmd_on_signal() {
  trap '' INT TERM HUP
  trap - ERR
  _ff_backup_cleanup
  _restore_forget_new_record
  rm -rf "$(ff_root)"/.download.??????
  # An update that has not started the new version is undone, so its
  # re-run is safe.
  if [[ ${FF_UPDATE_PHASE:-} == saved ]]; then _update_undo_change "$FF_UPDATE_OLD" || true; fi
  _restore_report "The ${FF_CMD:-command} was stopped (SIG$1) while ${FF_STEP:-working}, before it finished." \
    "${FF_TRAP_HINT:-to finish it, run: ${FF_RERUN:-the command} again}"
}

_ff_cmd_traps() {
  trap _ff_cmd_on_error ERR
  trap '_ff_cmd_on_signal INT' INT
  trap '_ff_cmd_on_signal TERM' TERM
  trap '_ff_cmd_on_signal HUP' HUP
}

# _ff_given_answers: the answer options given to this run, apart from
# --channel, as --name words (nothing when none was given).
_ff_given_answers() {
  local n v out=""
  while IFS= read -r n; do
    [[ $n != CHANNEL ]] || continue
    v="FF_$n"
    if [[ -n ${!v:-} ]]; then
      n=${n,,}
      out+="${out:+ }--${n//_/-}"
    fi
  done < <(_ff_answer_names)
  printf '%s' "$out"
}

# ------------------------------------------------------------
# Update (spec goals 12 and 12b)
# ------------------------------------------------------------

# _ff_reexec PATH ARGS...: replace this process with PATH (the new freeframe
# command) run with ARGS. FF_SELF_UPDATED=1 stops it from updating itself
# again, so this happens once.
_ff_reexec() {
  local path=$1
  shift
  export FF_SELF_UPDATED=1
  # The update holds the lock; the new command carries on with it.
  if [[ -n ${FF_LOCK_FD:-} ]]; then export FF_LOCK_FD; fi
  if [[ -n ${FF_UPDATE_PUT_BACK:-} ]]; then export FF_UPDATE_PUT_BACK; fi
  exec bash "$path" "$@"
}

# update_self CHANNEL: download deploy/freeframe from CHANNEL. When it is not
# the command running now, put it at ${FF_BIN_DIR:-/usr/local/bin}/freeframe
# (written beside it, then renamed over it, so the command is never half
# written) and run the new copy with this run's arguments instead. Stops,
# with nothing changed, when the download fails or is not a complete
# freeframe command.
update_self() {
  local ch=$1 dir=${FF_BIN_DIR:-/usr/local/bin} self=${BASH_SOURCE[0]} target new running=0
  [[ -z ${FF_SELF_UPDATED:-} ]] || return 0
  target="$dir/freeframe"
  new="$dir/.freeframe.new"
  say "Checking for a newer freeframe command on the $ch channel..."
  if ! { mkdir -p "$dir" && fetch "$ch" deploy/freeframe "$new" 2>/dev/null; }; then
    rm -f "$new"
    _ff_stop 1 "Could not download the freeframe command for the $ch channel, so $(_update_unchanged)." \
      "check that this server can reach raw.githubusercontent.com, then run sudo freeframe update again."
  fi
  if [[ $(head -n 1 "$new") != '#!/usr/bin/env bash' ]] || ! bash -n "$new" 2>/dev/null; then
    rm -f "$new"
    _ff_stop 1 "What was downloaded for the $ch channel is not a complete freeframe command, so $(_update_unchanged)." \
      "run sudo freeframe update again in a few minutes. If it keeps happening, report it at https://github.com/Techiebutler/freeframe/issues"
  fi
  if ! grep -qx "FF_SCRIPT_KIND=$FF_SCRIPT_KIND" "$new" || ! grep -q '^cmd_update() {' "$new"; then
    rm -f "$new"
    _ff_stop 1 "What was downloaded for the $ch channel is not the freeframe command, so $(_update_unchanged)." \
      "check that the channel is right (--channel stable or --channel latest), then run sudo freeframe update again."
  fi
  # Compared before the command is replaced: the script running now is
  # usually that very file.
  if cmp -s "$new" "$self"; then running=1; fi
  if [[ -f $target ]] && cmp -s "$new" "$target"; then
    rm -f "$new"
  else
    if ! { chmod 755 "$new" && mv -f "$new" "$target"; }; then
      rm -f "$new"
      _ff_stop 1 "The freeframe command could not be replaced in $dir, so $(_update_unchanged)." \
        "check that the disk is not full or read-only, then run sudo freeframe update again."
    fi
    say "The freeframe command was updated; continuing with the new one."
  fi
  if ((!running)); then
    _ff_reexec "$target" ${FF_ORIG_ARGS[@]+"${FF_ORIG_ARGS[@]}"}
  fi
}

# The update record ($FF_ROOT/.update-undo, mode 600) stands from just
# before an update replaces the setup files until that update ends well, or
# until `freeframe rollback` has taken the server back. It holds the version
# from before, the database backup taken first and the time;
# $FF_ROOT/rollback (mode 700) holds the setup files from before. While it
# stands, update refuses and backup never prunes that backup.
_update_undo_file() { printf '%s/.update-undo' "$(ff_root)"; }

# _update_undo_read: FF_UNDO_VERSION, FF_UNDO_BACKUP, FF_UNDO_TIME and
# FF_UNDO_PHASE from the record. 1 when there is none. The phase is saved
# (the files from before are kept; the new version has not started, so the
# old one is still what runs) or started (the new version was started). A
# record without one is read as started, the careful choice. FF_UNDO_RAW is
# the record as read (once, so the fields all come from the same record).
_update_undo_read() {
  local f line
  f=$(_update_undo_file)
  FF_UNDO_VERSION="" FF_UNDO_BACKUP="" FF_UNDO_TIME="" FF_UNDO_PHASE=started FF_UNDO_RAW=""
  [[ -f $f ]] || return 1
  FF_UNDO_RAW=$(cat "$f" 2>/dev/null) || return 1
  while IFS= read -r line; do
    case $line in
      version=*) FF_UNDO_VERSION=${line#version=} ;;
      backup=*) FF_UNDO_BACKUP=${line#backup=} ;;
      time=*) FF_UNDO_TIME=${line#time=} ;;
      phase=*) FF_UNDO_PHASE=${line#phase=} ;;
    esac
  done <<<"$FF_UNDO_RAW"
  return 0
}

# _update_undo_set VERSION BACKUP PHASE [TIME]
_update_undo_set() {
  local f
  f=$(_update_undo_file)
  (umask 077 && printf 'version=%s\nbackup=%s\ntime=%s\nphase=%s\n' "$1" "$2" \
    "${4:-$(date '+%Y-%m-%d %H:%M:%S %z')}" "$3" >"$f.tmp") &&
    chmod 600 "$f.tmp" && mv -f "$f.tmp" "$f" || return 1
  # On the disk, with its folder entry, before the update goes on: after a
  # power loss the record must not come back with the phase from before
  # (saved once the new version was started). A plain sync where sync
  # takes no file names.
  sync "$f" "$(ff_root)" 2>/dev/null || sync 2>/dev/null || true
}

# _update_undo_phase PHASE: the same record, now in PHASE.
_update_undo_phase() {
  _update_undo_read || return 1
  _update_undo_set "$FF_UNDO_VERSION" "$FF_UNDO_BACKUP" "$1" "$FF_UNDO_TIME"
}

_update_undo_clear() { rm -f "$(_update_undo_file)"; }

# _update_save_setup [REF]: keep the setup files in use now (the compose
# files and the backup units) in $FF_ROOT/rollback, replacing an older copy
# only once the new one is complete. With REF they are downloaded from that
# ref instead (the release that runs, when the files on disk are already
# another one's).
_update_save_setup() {
  local ref=${1:-} root new f dest
  root=$(ff_root)
  new="$root/rollback.new"
  rm -rf "$new" "$root/rollback.old" || return 1
  (umask 077 && mkdir "$new") || return 1
  chmod 700 "$new" || return 1
  for f in "${FF_SETUP_FILES[@]}"; do
    if [[ -n $ref ]]; then
      if ! _ff_logged fetch "$ref" "$f" "$new/${f##*/}"; then
        rm -rf "$new"
        return 1
      fi
      continue
    fi
    dest=$(_ff_setup_dest "$f")
    if [[ -e $dest ]] && ! cp -p "$dest" "$new/${f##*/}"; then
      rm -rf "$new"
      return 1
    fi
  done
  if [[ -d $root/rollback ]] && ! mv "$root/rollback" "$root/rollback.old"; then
    rm -rf "$new"
    return 1
  fi
  mv "$new" "$root/rollback" || return 1
  rm -rf "$root/rollback.old"
}

# _update_put_back: the setup files saved in $FF_ROOT/rollback back in
# place; a file that did not exist then is removed.
_update_put_back() {
  local root f dest name ok=0
  root=$(ff_root)
  [[ -d $root/rollback ]] || return 1
  for f in "${FF_SETUP_FILES[@]}"; do
    dest=$(_ff_setup_dest "$f")
    name=${f##*/}
    if [[ -e $root/rollback/$name ]]; then
      { cp -p "$root/rollback/$name" "$dest.tmp" && mv -f "$dest.tmp" "$dest"; } || ok=1
    else
      rm -f "$dest" || ok=1
    fi
  done
  return "$ok"
}

# _update_undo_change: an update that stopped before starting the new
# version puts the setup files from before back and drops its record, so
# FreeFrame is as it was and a plain re-run works.
_update_undo_change() {
  FF_UPDATE_PHASE=""
  if _update_put_back; then
    _update_undo_clear
    FF_STATE="FreeFrame is running the version it had ($1), with its setup files from before. Running sudo freeframe update again is safe."
    return 0
  fi
  FF_STATE="FreeFrame is still running the version it had ($1), but its setup files from before could not all be put back, so the record of this update is kept. To put everything back, run: sudo freeframe rollback"
  FF_TRAP_HINT="to put the setup files from before back, run: sudo freeframe rollback"
  return 1
}

# _update_fail_undone MESSAGE WHAT_TO_TRY [MESSAGE_IF_PUT_BACK]: an update
# that stops before the new version started: the setup files from before go
# back first, and the advice is the rollback when they could not. When they
# went back, MESSAGE_IF_PUT_BACK (if given) replaces MESSAGE.
_update_fail_undone() {
  if _update_undo_change "$FF_UPDATE_OLD"; then install_fail "${3:-$1}" "$2"; fi
  install_fail "$1" "$FF_TRAP_HINT"
}

# _ff_running_version: the release the running api container was started
# from (its image tag), or nothing when that cannot be told. An image named
# by digest (@sha256:...) says nothing reliable about its release.
_ff_running_version() {
  local img tag
  img=$(dc ps --format '{{.Image}}' api 2>/dev/null | head -n 1) || img=""
  [[ $img != *@* ]] || return 0
  [[ $img == */*:* || $img == *:* ]] || return 0
  tag=${img##*:}
  [[ $tag =~ ^v?[0-9][A-Za-z0-9._-]*$ ]] || return 0
  printf '%s' "${tag#v}"
}

# _update_unchanged: "nothing was changed", or, once this update has put an
# earlier one's setup files back (FF_UPDATE_PUT_BACK), what it did change.
_update_unchanged() {
  if [[ -n ${FF_UPDATE_PUT_BACK:-} ]]; then
    printf 'nothing else was changed (the setup files from before an earlier update that stopped part-way were put back first)'
  else
    printf 'nothing was changed'
  fi
}

# cmd_update: `freeframe update`. Updates the freeframe command itself first
# (and runs the new one), then: a database backup, the channel's setup files
# and backup units, the fill-missing settings merge, the new images, a
# restart and the health checks. If the new version does not come up, it
# prints the line that goes back, rather than guessing.
cmd_update() {
  local root file ch ref old new answers pinned url mode host running save_ref="" try
  root=$(ff_root)
  file="$root/.env.prod"
  if ((${#FF_ARGS[@]})); then
    _ff_bad_usage "freeframe update takes no other words. To use another channel, add for example: --channel stable"
  fi
  _ff_need_root update
  _ff_need_install
  answers=$(_ff_given_answers)
  if [[ -n $answers ]]; then
    _ff_stop 2 "freeframe update keeps the answers you gave when installing ($answers was given), so nothing was changed." \
      "to change the web address, email or storage, run: sudo freeframe configure"
  fi
  _ff_need_finished_install update
  FF_UPDATE_PUT_BACK=${FF_SELF_UPDATED:+${FF_UPDATE_PUT_BACK:-}}
  # The lock comes before anything is read or changed: a second update (from
  # another SSH session, say) must not touch a running one's files or record.
  if ! _ff_lock; then
    _ff_stop 1 "$FF_BUSY, so the update did not start. Nothing was changed." \
      "wait for it to finish, then run sudo freeframe update again."
  fi
  _ff_refuse_unfinished_restore update
  if _update_undo_read; then
    if [[ $FF_UNDO_PHASE == saved ]]; then
      # Killed (power loss, SIGKILL) before it started the new version: the
      # old version still runs, so its files go back and the update goes on.
      say "An earlier update stopped before it started the new version; putting its setup files from before back first..."
      if ! _update_put_back; then
        _ff_stop 1 "An earlier update stopped part-way and its setup files from before could not be put back, so this update did not start." \
          "to put everything back as it was before that update, run: sudo freeframe rollback"
      fi
      _update_undo_clear
      FF_UPDATE_PUT_BACK=1
    else
      # Its new version was started (and did not come up): removing the
      # record is right only when that new version works, so it is offered
      # only while the new version (the files on disk) is what runs.
      try="to go back to ${FF_UNDO_VERSION:-the version from before}, run: sudo freeframe rollback."
      running=$(_ff_running_version)
      if [[ -n $running && $running != "${FF_UNDO_VERSION:-}" && $running == "$(ff_version)" ]]; then
        try+=" If FreeFrame works well on $running as it is now, remove the record instead: sudo rm $(_ff_q "$(_update_undo_file)"), then run sudo freeframe update again."
      fi
      _ff_stop 1 "An earlier update did not finish (it started ${FF_UNDO_TIME:-earlier}, from version ${FF_UNDO_VERSION:-unknown}), so this update did not start. Nothing was changed." "$try"
    fi
  fi
  ch=$(ff_channel "$file")
  _ff_check_channel "$ch"
  # A pinned server stays on its version: its setup files come from that
  # release's tag, not from the channel.
  pinned=$(env_get "$file" FREEFRAME_VERSION)
  ref=$ch
  if [[ -n $pinned ]]; then
    ref="v${pinned#v}"
    if ! _ff_valid_ref "$ref"; then
      _ff_stop 1 "FREEFRAME_VERSION in $file ('$pinned') is not a release number, so $(_update_unchanged)." \
        "set it to a release such as 1.22.0, or delete the FREEFRAME_VERSION line to follow the $ch channel."
    fi
    # Releases up to 1.21.0 have no setup files for this command.
    if ! _ff_version_gt "$pinned" 1.21.0; then
      _ff_stop 1 "This server is pinned to version $pinned (FREEFRAME_VERSION in $file), and freeframe update can only manage releases after 1.21.0, which have the setup files it needs, so $(_update_unchanged)." \
        "delete the FREEFRAME_VERSION line from $file to follow the $ch channel, then run sudo freeframe update."
    fi
  fi

  # Spec goal 12b: the newest freeframe command does the rest.
  update_self "$ch"

  FF_ACTOR="the update"
  FF_STOPPED=()
  FF_ADMIN_CREATED="" FF_PW_GENERATED=""
  FF_RERUN="sudo freeframe update"
  FF_STATE="Nothing has been changed; FreeFrame is running as before."
  if [[ -n $FF_UPDATE_PUT_BACK ]]; then
    FF_STATE="FreeFrame is running as before; the setup files from before an earlier update that stopped part-way were put back first."
  fi
  FF_UPDATE_PHASE="" FF_TRAP_HINT=""
  _install_log_start update
  _ff_cmd_traps
  # The version from before is what runs. When the running containers are
  # another release than the files on disk say (an earlier update stopped
  # part-way and its record was removed by hand), the running one counts,
  # and its own release's setup files become the way back.
  old=$(ff_version)
  running=$(_ff_running_version)
  if [[ -n $running && $running != "$old" ]]; then
    # Said as it is: the files may be another release's because an update
    # stopped part-way, or FREEFRAME_VERSION may have been edited by hand.
    if [[ -n $pinned ]]; then
      say "FreeFrame runs version $running, but FREEFRAME_VERSION in $file asks for $old."
    else
      say "FreeFrame runs version $running, but the setup files here are for $old."
    fi
    say "The setup files of release v$running are kept as the way back."
    save_ref="v$running"
    new=$old
    old=$running
  fi

  FF_STEP="backing up the database"
  say "Saving a backup of the database first..."
  if ! backup_create prune; then
    install_fail "The update stopped before changing anything, because the database could not be backed up first." \
      "fix what the message above says, then run sudo freeframe update again."
  fi
  FF_UPDATE_BACKUP=$FF_BACKUP_MADE
  say "Saved the backup: $FF_UPDATE_BACKUP"
  FF_STATE+=" The backup taken first is $FF_UPDATE_BACKUP"

  # An explicit --channel is saved now, so a re-run without it keeps it.
  FF_STEP="saving the channel"
  if ! ff_save_channel "$file" "$ch"; then
    install_fail "The channel could not be saved in $file." \
      "check that the disk is not full, then run sudo freeframe update --channel $ch again."
  fi

  # Before anything is replaced: the setup files in use now, and the record
  # `freeframe rollback` goes back with.
  FF_STEP="saving the setup files in use"
  if ! _update_save_setup "$save_ref"; then
    if [[ -n $save_ref ]]; then
      install_fail "FreeFrame runs version $old, but the setup files in $root are for $new, and the setup files of release $save_ref could not be downloaded to keep as the way back, so nothing was changed." \
        "check that this server can reach raw.githubusercontent.com, then run sudo freeframe update again."
    fi
    install_fail "The setup files in use could not be saved for a rollback, so the update stopped before changing anything." \
      "check that the disk is not full, then run sudo freeframe update again."
  fi
  # From the record on, until the new version starts, any stop (a failure, a
  # signal, an error) puts the setup files from before back and drops the
  # record (_update_undo_change), since the old version is still what runs.
  FF_UPDATE_OLD=$old
  FF_UPDATE_PHASE=saved
  if ! _update_undo_set "$old" "$FF_UPDATE_BACKUP" saved; then
    _update_fail_undone "The setup files in use could not be saved for a rollback, so the update stopped before changing anything." \
      "check that the disk is not full, then run sudo freeframe update again."
  fi
  FF_STATE="FreeFrame is running $old as before; its setup files are saved for a rollback."

  FF_STEP="downloading the setup files"
  if [[ -n $pinned ]]; then
    say "This server is pinned to version $pinned (FREEFRAME_VERSION in $file), so it stays on that version"
    say "and takes the setup files of release $ref. To follow the $ch channel again, delete that line, then run sudo freeframe update."
    say "Downloading the setup files of release $ref..."
  else
    say "Downloading the setup files for the $ch channel..."
  fi
  if ! fetch_setup_files "$ref"; then
    try="check that this server can reach raw.githubusercontent.com and that the disk is not full, then run sudo freeframe update again."
    if [[ -n $pinned && $FF_FETCH_STAGE == download ]]; then
      try="check that this server can reach raw.githubusercontent.com. If it can, release $ref does not have these files: delete the FREEFRAME_VERSION line from $file to follow the $ch channel, then run sudo freeframe update."
    fi
    # A mixed set the saved copy then put back whole is not reported as mixed.
    _update_fail_undone "$(_ff_fetch_failure "$([[ -n $pinned ]] && printf 'release %s' "$ref" || printf 'the %s channel' "$ch")")" "$try" \
      "$([[ -n $FF_FETCH_MIXED ]] && printf 'The new %s could not be put in place; the setup files from before were put back from the copy saved before the update.' "${FF_FETCH_FAILED:-setup files}")"
  fi
  new=$(ff_version)

  FF_STEP="adding the settings the new release needs"
  if ! fill_settings "$file"; then
    _update_fail_undone "The settings could not be completed for the new release." \
      "fix what the message above says, then run sudo freeframe update again."
  fi

  if [[ ${FF_SKIP_PULL:-} != 1 ]]; then
    FF_STEP="downloading FreeFrame $new"
    say "Downloading FreeFrame $new (this can take a few minutes)..."
    if ! _ff_logged dc pull; then
      _update_fail_undone "FreeFrame $new could not be downloaded." \
        "check that this server can reach ghcr.io, then run sudo freeframe update again."
    fi
  fi

  url=$(env_get "$file" FRONTEND_URL)
  host=$(_ff_url_host "$url")
  mode=$(env_get "$file" FREEFRAME_HTTPS)
  FF_STEP="starting FreeFrame $new"
  # From here the new version may change the database: the way back is the
  # rollback, and the record says so.
  if ! _update_undo_phase started; then
    _update_fail_undone "The update could not note that it is starting the new version, so it stopped before starting it." \
      "check that the disk is not full, then run sudo freeframe update again."
  fi
  FF_UPDATE_PHASE=started
  FF_STATE="FreeFrame has been moved to $new. To go back to $old with the database as it was just before the update, run: sudo freeframe rollback"
  FF_TRAP_HINT="see why with: sudo freeframe logs. To go back to $old, run: sudo freeframe rollback"
  say "Starting FreeFrame $new..."
  if ! _ff_logged dc up -d --no-build; then
    install_fail "FreeFrame $new could not be started." "see why with: sudo freeframe logs"
  fi
  FF_STEP="waiting for FreeFrame to answer"
  say "Waiting for FreeFrame to finish starting (a new release may first update the database)..."
  if ! _ff_wait_healthy "${mode:-off}" "$host"; then
    install_fail "FreeFrame did not come back after the update to $new." \
      "see why with: sudo freeframe logs (the API's messages: sudo freeframe logs api)."
  fi
  # It answers: the way back is no longer needed, and no message names it.
  _update_undo_clear
  FF_UPDATE_PHASE=""
  FF_TRAP_HINT="the update itself is done. To refresh the nightly backup timer too, run sudo freeframe update again."
  FF_STATE="FreeFrame $new runs and answers at $url; only the nightly backup timer was still being refreshed (the one set up before keeps running)."
  FF_STEP="refreshing the nightly backups"
  if ! _ff_logged install_backup_timer; then
    warn "The nightly backup timer could not be refreshed; the one set up before keeps running. The reason is at the end of $FF_LOG."
  fi
  trap - ERR INT TERM HUP
  say ""
  if [[ -n $pinned ]]; then
    say "FreeFrame stays on the pinned version $pinned; its setup files and images were refreshed."
  elif [[ $old == "$new" ]]; then
    say "FreeFrame is already on the newest release of the $ch channel ($new); its setup files and images were refreshed."
  else
    say "FreeFrame was updated from $old to $new."
  fi
  say "It answers at $url."
  say "The database as it was just before the update is saved in $FF_UPDATE_BACKUP"
  _install_log_stop
}

# _ff_stop_project_app: stop this install's containers (compose project
# freeframe) except postgres and traefik, found by their labels, without
# reading the compose files.
_ff_stop_project_app() {
  local out line
  local -a ids=()
  out=$(docker ps --filter label=com.docker.compose.project=freeframe \
    --format '{{.ID}}|{{.Label "com.docker.compose.service"}}' 2>>"${FF_LOG:-/dev/null}") || return 1
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    case ${line#*|} in
      postgres | traefik) ;;
      *) ids+=("${line%%|*}") ;;
    esac
  done <<<"$out"
  ((${#ids[@]})) || return 0
  _ff_logged docker stop "${ids[@]}"
}

# _rollback_unstarted OLD: the rollback of an update whose new version was
# never started. The old version still runs on a database nothing has
# changed, so the setup files and the pin go back, the old version is
# started again (only what the files changed is recreated), and the
# database is left alone. Called with the lock, the log and the traps set.
_rollback_unstarted() {
  local old=$1 root file newv url mode host
  root=$(ff_root)
  file="$root/.env.prod"
  newv=$(ff_version)
  [[ $newv != "$old" ]] || newv=""
  say "The new version${newv:+ ($newv)} of that update never started, so the database is left as it is."
  FF_STATE="FreeFrame still runs $old and its database was not changed; its setup files may be partly the new release's. Running sudo freeframe rollback again is safe."
  FF_STEP="putting the setup files from before back"
  if ! _update_put_back; then
    install_fail "The setup files from before the update could not all be put back." \
      "check that the disk is not full, then run: sudo freeframe rollback"
  fi
  FF_STATE="FreeFrame still runs $old and its database was not changed. Its setup files are back as they were before the update; its version is not pinned yet. Running sudo freeframe rollback again is safe."
  FF_STEP="pinning version $old"
  if [[ $(env_get "$file" FREEFRAME_VERSION) != "$old" ]]; then
    if ! env_backup "$file" >/dev/null || ! env_set "$file" FREEFRAME_VERSION "$old"; then
      install_fail "FREEFRAME_VERSION could not be set to $old in $file." \
        "check that the disk is not full, then run: sudo freeframe rollback"
    fi
  fi
  say "Pinned version $old (FREEFRAME_VERSION in $file)."
  FF_STATE="The setup files and the version ($old) are back as they were before the update, and the database was not changed. Running sudo freeframe rollback again is safe."
  FF_STEP="starting FreeFrame $old"
  url=$(env_get "$file" FRONTEND_URL)
  host=$(_ff_url_host "$url")
  mode=$(env_get "$file" FREEFRAME_HTTPS)
  say "Starting FreeFrame $old with its setup files from before..."
  if ! _ff_logged dc up -d --no-build --remove-orphans; then
    install_fail "FreeFrame $old could not be started." "see why with: sudo freeframe logs"
  fi
  FF_STEP="waiting for FreeFrame to answer"
  if ! _ff_wait_healthy "${mode:-off}" "$host"; then
    install_fail "FreeFrame $old did not answer after the rollback." "see why with: sudo freeframe logs"
  fi
  if ! _ff_logged install_backup_timer; then
    warn "The nightly backup timer could not be refreshed; the one set up before keeps running. The reason is at the end of $FF_LOG."
  fi
  _update_undo_clear
  trap - ERR INT TERM HUP
  say ""
  say "FreeFrame is back on $old."
  say "The database was not changed: the new version${newv:+ ($newv)} never ran, so nothing written since the update began is lost."
  say "It answers at $url."
  say "This server now stays on $old. To try the update again later, delete the FREEFRAME_VERSION line from"
  say "$file, then run sudo freeframe update."
  _install_log_stop
}

# _rollback_check: read the update record and check that what a rollback
# needs is there. Sets the caller's old, backup, started, rec (the record as
# it is) and unsaved_try. 1 when there is no record; stops (nothing changed)
# when the rollback cannot go on. cmd_rollback calls it before its question
# and again under the lock, and acts only on what the second call read.
_rollback_check() {
  local f rec_q
  rec=""
  _update_undo_read || return 1
  rec=$FF_UNDO_RAW
  started=1
  old=$FF_UNDO_VERSION backup=$FF_UNDO_BACKUP
  [[ $FF_UNDO_PHASE != saved ]] || started=""
  rec_q=$(_ff_q "$(_update_undo_file)")
  # A new version that never started changed nothing in the database, so its
  # rollback needs no backup, and a restore is never the advice for it.
  unsaved_try="to put the database back as it was before the update, run: sudo freeframe restore --yes $(_ff_q "$backup")"
  if [[ -z $started ]]; then
    unsaved_try="the new version of that update never ran, so the database was not changed and the version from before still runs. To try the update again, remove the record and run it: sudo rm $rec_q && sudo freeframe update"
  fi
  if [[ ! $old =~ ^[A-Za-z0-9._-]+$ || $old == unknown ]]; then
    _ff_stop 1 "The record of the last update ($(_update_undo_file)) does not say which version it came from, so nothing was changed." \
      "$unsaved_try"
  fi
  if [[ -n $started ]] && ! _ff_is_pg_dump "$backup"; then
    _ff_stop 1 "The backup taken before the update ($backup) is not there any more, so the database cannot be put back and nothing was changed." \
      "if you have a copy of it, put it back at that path, then run sudo freeframe rollback again."
  fi
  if [[ ! -d $root/rollback ]]; then
    _ff_stop 1 "The setup files saved before the update ($root/rollback) are missing, so nothing was changed." \
      "$unsaved_try"
  fi
  # A file missing from the saved set reads as "new in that release" and is
  # removed when the set goes back, so the two every server has must be there.
  for f in docker-compose.prod.yml docker-compose.images.yml; do
    if [[ ! -s $root/rollback/$f ]]; then
      _ff_stop 1 "The setup files saved before the update ($root/rollback) are incomplete: $f is missing, so nothing was changed." \
        "$unsaved_try"
    fi
  done
}

# cmd_rollback: `freeframe rollback`: take the server back to the version
# it had before an update that did not end well, with the database as it was
# just before that update. In order: stop the app containers, put the setup
# files from before back, pin FREEFRAME_VERSION to the old version, restore
# the update's backup (restore_database, which never starts FreeFrame on an
# early failure here: the old version must not run on the database the
# update left), then start and wait for health, and drop the record. Every
# step can be repeated, so running it again after a failure is safe.
# When the record says the new version was never started (phase saved),
# nothing has changed the database: then only the setup files and the pin go
# back and the old version is started again; the database is not touched,
# so nothing written since the update began is lost, and no yes is needed.
cmd_rollback() {
  local root file old backup when out s url mode host answers started=1 unsaved_try rec seen seen_started
  local -a all=() svcs=()
  root=$(ff_root)
  file="$root/.env.prod"
  if ((${#FF_ARGS[@]})); then _ff_bad_usage "freeframe rollback takes no other words."; fi
  _ff_need_root rollback
  _ff_need_install
  answers=$(_ff_given_answers)
  if [[ -n $answers ]]; then
    _ff_stop 2 "freeframe rollback takes no answers ($answers was given), so nothing was changed." \
      "to change the web address, email or storage, run: sudo freeframe configure"
  fi
  if ! _rollback_check; then
    say "There is no update to roll back: the last update finished (or none was made), so nothing was changed."
    say "To put back an older copy of the database instead, see: sudo freeframe restore"
    return 0
  fi
  when=$(_ff_stamp_date "${backup##*/}")
  if [[ -n $started && -z ${FF_YES:-} ]]; then
    if ! _ff_has_tty; then
      _ff_stop 2 "Rolling back replaces FreeFrame's database, so it needs a yes, and there is no terminal here to ask." \
        "run sudo freeframe rollback in a terminal, or add --yes to it."
    fi
    say "This takes FreeFrame back to version $old, as it was before the update${FF_UNDO_TIME:+ of $FF_UNDO_TIME}:"
    say "  the setup files and the version go back to $old, and the database goes back to the backup"
    say "  taken just before the update${when:+ ($when)}: $backup"
    say "Projects, comments, people and share links added or changed since then will be gone."
    say "A copy of the current database is saved first. FreeFrame is stopped while this runs."
    if ! confirm "Roll back now?" N; then
      say "Rollback cancelled. Nothing was changed."
      exit 1
    fi
  fi

  # The question is asked before the lock, so nothing waits on an answer.
  # An update may have moved on meanwhile: what is done is worked out again
  # from the record as it is under the lock, and anything other than what
  # was asked about is refused.
  if ! _ff_lock; then
    _ff_stop 1 "$FF_BUSY, so the rollback did not start. Nothing was changed." \
      "wait a few minutes for it to finish, then run sudo freeframe rollback again."
  fi
  seen=$rec seen_started=$started
  if ! _rollback_check; then
    say "There is no update to roll back any more: while this rollback was getting ready, the update it was for ended (or another rollback finished it), so nothing was changed."
    say "To see how FreeFrame is now, run: sudo freeframe status"
    return 0
  fi
  if [[ -n $started && -z $seen_started ]]; then
    _ff_stop 1 "While this rollback was getting ready, the update went on to start its new version, which may have changed the database. Rolling it back now replaces the database, which this rollback did not say or ask, so it did not start. Nothing was changed." \
      "run sudo freeframe rollback again: it says what it will do and asks first."
  fi
  if [[ $rec != "$seen" ]]; then
    _ff_stop 1 "The record of the update ($(_update_undo_file)) changed while this rollback was getting ready, so what this rollback said it would do may not be what it would do now. It did not start. Nothing was changed." \
      "run sudo freeframe rollback again to see what it would do now."
  fi
  FF_ACTOR="the rollback"
  FF_STOPPED=()
  FF_ADMIN_CREATED="" FF_PW_GENERATED=""
  FF_RERUN="sudo freeframe rollback"
  FF_STATE="Nothing has been changed."
  FF_STATE_PREFIX=""
  FF_RECORD_NEW="" FF_DROP_STARTED="" FF_RESTORE_FILE=$backup
  _install_log_start rollback
  _ff_cmd_traps
  say "Rolling back to $old..."
  if [[ -z $started ]]; then
    _rollback_unstarted "$old"
    return 0
  fi

  FF_STEP="stopping FreeFrame"
  say "Stopping FreeFrame (its web address shows an error until the rollback is done)..."
  FF_STATE="FreeFrame may be partly stopped; nothing else has been changed. Running sudo freeframe rollback again is safe."
  if out=$(dc config --services 2>>"$FF_LOG"); then
    mapfile -t all <<<"$out"
    for s in "${all[@]}"; do
      if [[ -n $s && $s != postgres && $s != traefik ]]; then svcs+=("$s"); fi
    done
    if ((${#svcs[@]})) && ! _ff_logged dc stop "${svcs[@]}"; then
      install_fail "FreeFrame could not be stopped." "the reason is at the end of $FF_LOG. Then run: sudo freeframe rollback"
    fi
  # The compose files in place may be the very thing that is broken: then
  # the containers are found by their compose project instead.
  elif ! _ff_stop_project_app; then
    install_fail "FreeFrame could not be stopped." "the reason is at the end of $FF_LOG. Then run: sudo freeframe rollback"
  fi
  FF_STATE="FreeFrame is stopped; nothing else has been changed. Running sudo freeframe rollback again is safe."

  FF_STEP="putting the setup files from before back"
  if ! _update_put_back; then
    install_fail "The setup files from before the update could not all be put back." \
      "check that the disk is not full, then run: sudo freeframe rollback"
  fi
  FF_STATE="FreeFrame is stopped. Its setup files are back as they were before the update; its version and database are not yet. Running sudo freeframe rollback again is safe."

  FF_STEP="pinning version $old"
  if [[ $(env_get "$file" FREEFRAME_VERSION) != "$old" ]]; then
    if ! env_backup "$file" >/dev/null || ! env_set "$file" FREEFRAME_VERSION "$old"; then
      install_fail "FREEFRAME_VERSION could not be set to $old in $file." \
        "check that the disk is not full, then run: sudo freeframe rollback"
    fi
  fi
  say "Pinned version $old (FREEFRAME_VERSION in $file)."

  # From here the database still holds what the update left, which $old
  # must not start on: restore_database starts nothing when it fails.
  FF_STATE_PREFIX="FreeFrame is stopped. Its setup files and version are back to $old, but the database is not yet back as it was before the update, so FreeFrame stays stopped. Running sudo freeframe rollback again is safe."
  FF_STATE=""
  FF_RESTORE_NO_START=1
  restore_database "$backup"
  FF_RESTORE_NO_START=""

  FF_STATE_PREFIX=""
  FF_STATE="The setup files, the version ($old) and the database are back as they were before the update. Running sudo freeframe rollback again is safe."
  FF_STEP="starting FreeFrame $old"
  url=$(env_get "$file" FRONTEND_URL)
  host=$(_ff_url_host "$url")
  mode=$(env_get "$file" FREEFRAME_HTTPS)
  say "Starting FreeFrame $old..."
  if ! _ff_logged dc up -d --no-build --remove-orphans; then
    install_fail "FreeFrame $old could not be started." "see why with: sudo freeframe logs"
  fi
  FF_STEP="waiting for FreeFrame to answer"
  if ! _ff_wait_healthy "${mode:-off}" "$host"; then
    install_fail "FreeFrame $old did not answer after the rollback." "see why with: sudo freeframe logs"
  fi
  if ! _ff_logged install_backup_timer; then
    warn "The nightly backup timer could not be refreshed; the one set up before keeps running. The reason is at the end of $FF_LOG."
  fi
  _update_undo_clear
  trap - ERR INT TERM HUP
  say ""
  say "FreeFrame is back on $old, with the database as it was just before the update${when:+ ($when)}."
  say "It answers at $url."
  say "This server now stays on $old. To try the update again later, delete the FREEFRAME_VERSION line from"
  say "$file, then run sudo freeframe update."
  _install_log_stop
}

# ------------------------------------------------------------
# Configure (spec goal 12c)
#
# Asks the install questions again with the current answers as defaults (or
# takes new answers as options with --yes), then changes only the keys tied
# to the answers that changed, after backing up .env.prod. Generated secrets
# are never written; footage is never moved between storage places.
# ------------------------------------------------------------

# Keys configure never writes: the generated secrets and what is built from
# them. The bundled storage's S3 keys are generated too and join the list
# there.
FF_PROTECTED_KEYS="POSTGRES_PASSWORD REDIS_PASSWORD JWT_SECRET DATABASE_URL REDIS_URL POSTGRES_USER POSTGRES_DB"

# _cfg_set KEY VALUE: KEY is to become VALUE (only noted when that is a
# change).
_cfg_set() {
  local key=$1 value=$2 i
  if [[ $(env_get "$FF_CFG_FILE" "$key") == "$value" ]]; then
    for i in "${!FF_CFG_KEYS[@]}"; do
      if [[ ${FF_CFG_KEYS[i]} == "$key" ]]; then unset 'FF_CFG_KEYS[i]'; fi
    done
    unset 'FF_CFG_NEW[$key]'
    return 0
  fi
  [[ -n ${FF_CFG_NEW[$key]+x} ]] || FF_CFG_KEYS+=("$key")
  FF_CFG_NEW[$key]=$value
}

# _cfg_address MODE HOST: the web address keys for MODE (own, sslip, off)
# on HOST, as install writes them.
_cfg_address() {
  local mode=$1 host=$2
  FF_CFG_MODE=$mode FF_CFG_HOST=$host
  _cfg_set FREEFRAME_HTTPS "$mode"
  if [[ $mode == off ]]; then
    _cfg_set FRONTEND_URL "http://$host"
    _cfg_set DOMAIN ""
  else
    _cfg_set FRONTEND_URL "https://$host"
    _cfg_set DOMAIN "$host"
  fi
  [[ $FF_CFG_STORAGE == bundled ]] || return 0
  if [[ $mode == off ]]; then
    _cfg_set S3_PUBLIC_ENDPOINT "http://$host:9000"
    _cfg_set STORAGE_DOMAIN ""
    _cfg_set STORAGE_ROUTED false
    _cfg_set STORAGE_PORT_BIND 0.0.0.0:9000
  else
    _cfg_set S3_PUBLIC_ENDPOINT "https://storage.$host"
    _cfg_set STORAGE_DOMAIN "storage.$host"
    _cfg_set STORAGE_ROUTED true
    _cfg_set STORAGE_PORT_BIND 127.0.0.1:9000
  fi
}

# _cfg_address_from_options: --domain / --https given ahead of time.
_cfg_address_from_options() {
  local mode=${FF_HTTPS:-auto} host=""
  case $mode in
    auto | own | sslip | off) ;;
    *) _ff_answer_error "FREEFRAME_HTTPS (--https) must be own, sslip or off; it is '$FF_HTTPS'." "use one of those words." ;;
  esac
  install_find_ip
  if [[ -n ${FF_DOMAIN:-} ]]; then
    host=$(_ff_clean_host "$FF_DOMAIN")
    if ! valid_hostname "$host"; then
      _ff_answer_error "The web address '$host' is not a plain name like review.yourstudio.com." \
        "give only the name, without a port, a path or spaces."
    fi
    if _ff_is_ipv4 "$host"; then
      [[ $mode == auto || $mode == off ]] ||
        _ff_answer_error "A certificate needs a name, not an IP address ($host)." "use a domain name, or plain HTTP with --https off."
      mode=off
    elif [[ $mode == sslip ]]; then
      _ff_answer_error "Both a domain ($host) and the automatic sslip.io address were asked for." \
        "choose one: --domain for your own address, or --https sslip for the automatic one."
    elif [[ $mode == auto ]]; then
      mode=own
    fi
  else
    case $mode in
      sslip)
        if ! is_public_ipv4 "$FF_IP"; then
          _ff_answer_error "The automatic sslip.io address needs a public IPv4 address, and this server's is '$FF_IP'." \
            "use your own domain (--domain), or plain HTTP (--https off)."
        fi
        host=$(sslip_host "$FF_IP")
        ;;
      off)
        if [[ $FF_CFG_CUR_MODE == off ]]; then host=$FF_CFG_CUR_HOST; else host=$(_install_http_ip); fi
        ;;
      own)
        if [[ $FF_CFG_CUR_MODE != sslip ]] && ! _ff_is_ipv4 "$FF_CFG_CUR_HOST"; then
          host=$FF_CFG_CUR_HOST
        else
          _ff_answer_error "HTTPS on your own domain needs the domain." "add it, for example: --domain review.yourstudio.com"
        fi
        ;;
      *) return 0 ;;
    esac
  fi
  _cfg_address "$mode" "$host"
}

# _cfg_address_ask: the web address question, the current one as default.
_cfg_address_ask() {
  local answer="" label="" http_ip
  install_find_ip
  http_ip=$(_install_http_ip)
  case $FF_CFG_CUR_MODE in
    sslip) label=" (a free temporary address)" ;;
    off) label=" (plain HTTP)" ;;
  esac
  say ""
  say "1. Web address"
  say "   Now: $FF_CFG_CUR_URL$label"
  say "   Press Enter to keep it, or type your own domain (for example review.yourstudio.com)."
  if is_public_ipv4 "$FF_IP" && [[ $FF_CFG_CUR_MODE != sslip ]]; then
    say "   Or type temporary for the free address with HTTPS, $(sslip_host "$FF_IP")."
  fi
  if [[ $FF_CFG_CUR_MODE != off ]]; then
    say "   Or type http for plain HTTP on this server's address, http://$http_ip (for use inside your office network)."
  fi
  while :; do
    ask answer "   Web address" "" || _ff_input_ended
    answer=$(_ff_clean_host "$answer")
    case $answer in
      "") return 0 ;;
      temporary | sslip | automatic)
        if is_public_ipv4 "$FF_IP"; then
          _cfg_address sslip "$(sslip_host "$FF_IP")"
          return 0
        fi
        say "   The free temporary address needs a public IP address, and this server's is $FF_IP."
        continue
        ;;
      http | local)
        if [[ $FF_CFG_CUR_MODE != off ]]; then _cfg_address off "$http_ip"; fi
        return 0
        ;;
    esac
    if _ff_is_ipv4 "$answer"; then
      _cfg_address off "$answer"
      return 0
    fi
    if valid_hostname "$answer"; then
      _cfg_address own "$answer"
      return 0
    fi
    say "   '$answer' is not a plain name like review.yourstudio.com. Type only the name, without a port, a path or spaces."
  done
}

# _cfg_acme: HTTPS needs an email for certificate notices.
_cfg_acme() {
  local cur
  cur=$(env_get "$FF_CFG_FILE" ACME_EMAIL)
  if [[ -n ${FF_ACME_EMAIL:-} ]]; then
    valid_email "$FF_ACME_EMAIL" ||
      _ff_answer_error "'$FF_ACME_EMAIL' does not look like an email address (the email for certificate notices)." "give an address such as you@yourstudio.com."
    _cfg_set ACME_EMAIL "$FF_ACME_EMAIL"
    return 0
  fi
  [[ -n ${FF_CFG_NEW[FRONTEND_URL]:-} && ${FF_CFG_MODE:-off} != off && -z $cur ]] || return 0
  if _ff_interactive; then
    say ""
    say "   Let's Encrypt, who issue the free HTTPS certificate, write to this address if it needs attention."
    _ff_ask_email FF_ACME_EMAIL "   Email for certificate notices" ""
  else
    require_answer FF_ACME_EMAIL FREEFRAME_ACME_EMAIL "the email for certificate notices" || _ff_answer_missing
    valid_email "$FF_ACME_EMAIL" ||
      _ff_answer_error "'$FF_ACME_EMAIL' does not look like an email address (the email for certificate notices)." "give an address such as you@yourstudio.com."
  fi
  _cfg_set ACME_EMAIL "$FF_ACME_EMAIL"
}

# _cfg_smtp HOST PORT USER PASSWORD FROM: the email keys for these answers.
_cfg_smtp() {
  local host=$1 port=$2 user=$3 pw=$4 from=$5 cur_port
  host=$(_ff_clean_host "$host")
  if ! valid_hostname "$host"; then
    _ff_answer_error "The mail server '$host' is not a plain name like smtp.postmarkapp.com." "give only the server's name."
  fi
  if [[ ! $port =~ ^[0-9]{1,5}$ ]] || ((10#$port < 1 || 10#$port > 65535)); then
    _ff_answer_error "The mail server port '$port' is not a port number." "use the port your email provider gives, usually 587 or 465."
  fi
  if [[ -z $from ]] && valid_email "$user"; then from=$user; fi
  FF_SMTP_FROM=$from
  require_answer FF_SMTP_FROM FREEFRAME_SMTP_FROM "the address emails are sent from" || _ff_answer_missing
  if ! valid_email "$FF_SMTP_FROM"; then
    _ff_answer_error "'$FF_SMTP_FROM' does not look like an email address (the address emails are sent from)." "give an address such as noreply@yourstudio.com."
  fi
  cur_port=$(env_get "$FF_CFG_FILE" SMTP_PORT)
  _cfg_set MAIL_PROVIDER smtp
  _cfg_set SMTP_HOST "$host"
  _cfg_set SMTP_PORT "$port"
  # Port 465 is TLS from the first byte; anything else upgrades with
  # STARTTLS. Only recomputed when the port changes.
  if [[ $port != "$cur_port" || -z $(env_get "$FF_CFG_FILE" SMTP_USE_TLS) ]]; then
    if [[ $port == 465 ]]; then _cfg_set SMTP_USE_TLS false; else _cfg_set SMTP_USE_TLS true; fi
  fi
  _cfg_set SMTP_USER "$user"
  _cfg_set SMTP_PASSWORD "$pw"
  _cfg_set MAIL_FROM_ADDRESS "$FF_SMTP_FROM"
}

_cfg_email() {
  local f=$FF_CFG_FILE host port user pw from answer="" def
  host=$(env_get "$f" SMTP_HOST)
  port=$(env_get "$f" SMTP_PORT)
  user=$(env_get "$f" SMTP_USER)
  pw=$(env_get "$f" SMTP_PASSWORD)
  from=$(env_get "$f" MAIL_FROM_ADDRESS)
  if [[ -n ${FF_SMTP_HOST:-}${FF_SMTP_PORT:-}${FF_SMTP_USER:-}${FF_SMTP_PASSWORD:-}${FF_SMTP_FROM:-} ]]; then
    if [[ -z ${FF_SMTP_HOST:-$host} ]]; then
      _ff_answer_error "To set up email, the mail server is needed." "add it, for example: --smtp-host smtp.postmarkapp.com"
    fi
    _cfg_smtp "${FF_SMTP_HOST:-$host}" "${FF_SMTP_PORT:-${port:-587}}" "${FF_SMTP_USER:-$user}" \
      "${FF_SMTP_PASSWORD:-$pw}" "${FF_SMTP_FROM:-$from}"
    return 0
  fi
  _ff_interactive || return 0
  say ""
  say "2. Sending email (sign-in codes and invitations)"
  if [[ -n $host ]]; then
    say "   Now: through $host, port ${port:-587}, from ${from:-(no address)}"
    say "   Press Enter to keep it, or type the mail server's address to change it."
  else
    say "   Now: not set up, so sign-in codes and invitation emails are not sent."
    say "   Type your mail server's address (SMTP host, for example smtp.postmarkapp.com), or press Enter to leave it."
  fi
  while :; do
    ask answer "   Mail server" "" || _ff_input_ended
    answer=$(_ff_clean_host "$answer")
    [[ -n $answer ]] || return 0
    valid_hostname "$answer" && break
    say "   '$answer' is not a plain name like smtp.postmarkapp.com. Type only the server's name."
  done
  while :; do
    ask port "   Port" "${port:-587}" || _ff_input_ended
    [[ $port =~ ^[0-9]{1,5}$ ]] && ((10#$port >= 1 && 10#$port <= 65535)) && break
    say "   Type a port number, usually 587 or 465."
  done
  ask user "   User name" "$user" || _ff_input_ended
  if [[ -n $pw ]]; then
    ask_secret FF_SMTP_PASSWORD "   Password (press Enter to keep the current one)" || _ff_input_ended
  else
    ask_secret FF_SMTP_PASSWORD "   Password" || _ff_input_ended
  fi
  pw=${FF_SMTP_PASSWORD:-$pw}
  def=$from
  if [[ -z $def ]] && valid_email "$user"; then def=$user; fi
  _ff_ask_email from "   Send emails from (address)" "$def"
  _cfg_smtp "$answer" "$port" "$user" "$pw" "$from"
}

# _cfg_storage_refuse WANTED: configure does not move footage.
_cfg_storage_refuse() {
  local where="on this server" in=""
  [[ $FF_CFG_STORAGE == bundled ]] || where="in the S3 bucket $(env_get "$FF_CFG_FILE" S3_BUCKET)"
  if _ff_interactive; then in="   "; fi
  say "${in}configure does not move footage between this server and an S3 bucket, so footage stays where it is ($where)."
  say "${in}Footage already uploaded would be left behind and stop showing in FreeFrame. Moving it is done by hand; the guide explains how: $FF_GUIDE_URL"
}

# _cfg_s3_set ENDPOINT BUCKET ACCESS SECRET REGION: your own bucket's keys.
_cfg_s3_set() {
  local endpoint=$1 bucket=$2 access=$3 secret=$4 region=$5 v old_bucket re_bucket='^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$'
  if [[ -n $endpoint && ! $endpoint =~ ^https?://[^[:space:]]+$ ]]; then
    _ff_answer_error "The storage endpoint '$endpoint' must be a web address starting with https:// (or http:// for storage on your own network)." "copy the endpoint address exactly as your storage provider shows it."
  fi
  if [[ ! $bucket =~ $re_bucket ]]; then
    _ff_answer_error "The bucket name '$bucket' can only hold lowercase letters, digits, dots and hyphens." "check the bucket name at your storage provider."
  fi
  if [[ -z $access || -z $secret ]]; then
    _ff_answer_error "Your bucket's access key and secret key are both needed." "give them as FREEFRAME_S3_ACCESS_KEY and FREEFRAME_S3_SECRET_KEY."
  fi
  v=${endpoint#*://}
  v=${v%%[/:]*}
  v=${v,,}
  if [[ -z $endpoint || $v == amazonaws.com || $v == *.amazonaws.com ]]; then
    _cfg_set S3_STORAGE s3
  else
    _cfg_set S3_STORAGE minio
  fi
  _cfg_set S3_ENDPOINT "$endpoint"
  old_bucket=$(env_get "$FF_CFG_FILE" S3_BUCKET)
  _cfg_set S3_BUCKET "$bucket"
  _cfg_set S3_ACCESS_KEY "$access"
  _cfg_set S3_SECRET_KEY "$secret"
  _cfg_set S3_REGION "$region"
  if [[ -n ${FF_CFG_NEW[S3_BUCKET]+x} ]]; then
    FF_CFG_NOTES+=("Footage already uploaded stays in $old_bucket; configure does not move it to $bucket.")
  fi
}

_cfg_storage() {
  local f=$FF_CFG_FILE s3 answer="" cur_n=1 endpoint bucket access secret region
  local given=${FF_S3_ENDPOINT:-}${FF_S3_BUCKET:-}${FF_S3_ACCESS_KEY:-}${FF_S3_SECRET_KEY:-}${FF_S3_REGION:-}
  if [[ -n ${FF_STORAGE:-} && $FF_STORAGE != "$FF_CFG_STORAGE" ]]; then
    _cfg_storage_refuse >&2
    _ff_stop 2 "Nothing was changed." "keep --storage out, or set up a new FreeFrame with the other storage."
  fi
  if [[ $FF_CFG_STORAGE == bundled ]]; then
    if [[ -n $given ]]; then
      _cfg_storage_refuse >&2
      _ff_stop 2 "This server keeps footage on itself, and the keys of that storage are made by FreeFrame, so they cannot be set. Nothing was changed." \
        "leave the --s3-... options and FREEFRAME_S3_... variables out."
    fi
  fi
  endpoint=$(env_get "$f" S3_ENDPOINT)
  bucket=$(env_get "$f" S3_BUCKET)
  access=$(env_get "$f" S3_ACCESS_KEY)
  secret=$(env_get "$f" S3_SECRET_KEY)
  region=$(env_get "$f" S3_REGION)
  if [[ $FF_CFG_STORAGE == s3 && -n $given ]]; then
    _cfg_s3_set "${FF_S3_ENDPOINT:-$endpoint}" "${FF_S3_BUCKET:-$bucket}" "${FF_S3_ACCESS_KEY:-$access}" \
      "${FF_S3_SECRET_KEY:-$secret}" "${FF_S3_REGION:-$region}"
    return 0
  fi
  _ff_interactive || return 0
  [[ $FF_CFG_STORAGE == bundled ]] || cur_n=2
  say ""
  say "3. Where uploaded footage is kept"
  if [[ $FF_CFG_STORAGE == bundled ]]; then
    say "   Now: on this server"
  else
    say "   Now: in your S3 bucket $bucket${endpoint:+ at $endpoint}"
  fi
  say "   1) On this server  2) In an S3 bucket"
  while :; do
    ask answer "   Choose 1 or 2" "$cur_n" || _ff_input_ended
    case ${answer,,} in
      1 | bundled) s3=1 ;;
      2 | s3) s3=2 ;;
      *)
        say "   Type 1 or 2."
        continue
        ;;
    esac
    break
  done
  if [[ $s3 != "$cur_n" ]]; then
    _cfg_storage_refuse
    return 0
  fi
  [[ $FF_CFG_STORAGE == s3 ]] || return 0
  confirm "   Change the bucket's details (address, name, keys or region)?" N || return 0
  ask endpoint "   Endpoint (empty for AWS S3)" "$endpoint" || _ff_input_ended
  ask bucket "   Bucket name" "$bucket" || _ff_input_ended
  ask access "   Access key" "$access" || _ff_input_ended
  ask_secret answer "   Secret key (press Enter to keep the current one)" || _ff_input_ended
  secret=${answer:-$secret}
  ask region "   Region" "$region" || _ff_input_ended
  _cfg_s3_set "$endpoint" "$bucket" "$access" "$secret" "$region"
}

# _cfg_show: the changes, before anything is written. Passwords and keys are
# never shown.
_cfg_show() {
  local k old new
  say ""
  say "These settings will change:"
  for k in "${FF_CFG_KEYS[@]}"; do
    case $k in
      SMTP_PASSWORD | S3_ACCESS_KEY | S3_SECRET_KEY) say "  $k: (changed; not shown)" ;;
      *)
        old=$(env_get "$FF_CFG_FILE" "$k")
        new=${FF_CFG_NEW[$k]}
        say "  $k: ${old:-(empty)} -> ${new:-(empty)}"
        ;;
    esac
  done
  for k in ${FF_CFG_NOTES[@]+"${FF_CFG_NOTES[@]}"}; do say "$k"; done
  if [[ -n ${FF_CFG_NEW[FRONTEND_URL]:-} ]]; then
    say ""
    say "The web address changes from $FF_CFG_CUR_URL to ${FF_CFG_NEW[FRONTEND_URL]}."
    say "Links already sent by email (invitations, sign-in links and shared review links) point at the old"
    say "address and stop working. Send them again from FreeFrame once it runs at the new address."
    say "Everyone signs in again there."
  fi
}

# cmd_configure: `freeframe configure` (spec goal 12c).
cmd_configure() {
  local root file k backup="" restart=0 http_switch=0 protected hosts h url ok
  root=$(ff_root)
  file="$root/.env.prod"
  if ((${#FF_ARGS[@]})); then
    _ff_bad_usage "freeframe configure takes no other words; give new answers as options, for example: sudo freeframe configure --yes --domain review.yourstudio.com"
  fi
  _ff_need_root configure
  _ff_need_install
  _ff_need_finished_install configure
  # The lock is taken only once the answers are in, so no other command
  # waits on a question. Asked first anyway: while another command holds it,
  # its own files (a running restore's record, say) say nothing yet.
  if _ff_lock_busy; then
    _ff_stop 1 "$FF_BUSY, so the settings were not changed." \
      "wait a few minutes for it to finish, then run sudo freeframe configure again."
  fi
  _ff_refuse_unfinished_restore configure
  if [[ -z ${FF_YES:-} ]] && ! _ff_has_tty; then
    _ff_stop 2 "There is no terminal here to ask configure's questions." \
      "add --yes and give the new answers as options, for example: sudo freeframe configure --yes --domain review.yourstudio.com"
  fi
  FF_CFG_FILE=$file
  FF_CFG_KEYS=()
  FF_CFG_NOTES=()
  declare -gA FF_CFG_NEW=()
  FF_CFG_STORAGE=$(env_get "$file" FREEFRAME_STORAGE)
  FF_CFG_STORAGE=${FF_CFG_STORAGE:-bundled}
  FF_CFG_CUR_URL=$(env_get "$file" FRONTEND_URL)
  FF_CFG_CUR_HOST=$(_ff_url_host "$FF_CFG_CUR_URL")
  FF_CFG_CUR_MODE=$(env_get "$file" FREEFRAME_HTTPS)
  if [[ -z $FF_CFG_CUR_MODE ]]; then
    if [[ $FF_CFG_CUR_URL == https://* ]]; then FF_CFG_CUR_MODE=own; else FF_CFG_CUR_MODE=off; fi
  fi
  FF_CFG_MODE=$FF_CFG_CUR_MODE FF_CFG_HOST=$FF_CFG_CUR_HOST
  FF_ACTOR="freeframe configure"
  FF_STOPPED=()
  FF_ADMIN_CREATED="" FF_PW_GENERATED=""
  FF_RERUN="sudo freeframe configure"
  FF_STATE="Nothing has been changed."

  if [[ -n ${FF_CHANNEL:-} ]]; then
    _ff_check_channel "$FF_CHANNEL"
    _cfg_set FREEFRAME_CHANNEL "$FF_CHANNEL"
  fi
  # Storage first: a refused switch stops before any question is asked.
  if [[ -n ${FF_STORAGE:-}${FF_S3_ENDPOINT:-}${FF_S3_BUCKET:-}${FF_S3_ACCESS_KEY:-}${FF_S3_SECRET_KEY:-}${FF_S3_REGION:-} ]]; then
    _cfg_storage
  fi
  if [[ -n ${FF_DOMAIN:-} || ( -n ${FF_HTTPS:-} && $FF_HTTPS != auto ) ]]; then
    _cfg_address_from_options
  elif _ff_interactive; then
    _cfg_address_ask
  fi
  _cfg_acme
  _cfg_email
  if [[ -z ${FF_STORAGE:-}${FF_S3_ENDPOINT:-}${FF_S3_BUCKET:-}${FF_S3_ACCESS_KEY:-}${FF_S3_SECRET_KEY:-}${FF_S3_REGION:-} ]]; then
    _cfg_storage
  fi

  if ((${#FF_CFG_KEYS[@]} == 0)); then
    say ""
    say "Nothing to change; the settings are as they were."
    return 0
  fi
  # Belt and braces: the generated secrets are never written.
  protected=$FF_PROTECTED_KEYS
  [[ $FF_CFG_STORAGE != bundled ]] || protected+=" S3_ACCESS_KEY S3_SECRET_KEY"
  for k in "${FF_CFG_KEYS[@]}"; do
    if [[ " $protected " == *" $k "* ]]; then
      _ff_stop 1 "configure was about to change $k, which it never changes, so it stopped. Nothing was changed." \
        "report this at https://github.com/Techiebutler/freeframe/issues"
    fi
    [[ $k == FREEFRAME_CHANNEL ]] || restart=1
  done
  _cfg_show
  if _ff_interactive; then
    local question="Save these changes and restart FreeFrame?"
    ((restart)) || question="Save this change?"
    if ! confirm "$question" Y; then
      say "Nothing was changed."
      exit 1
    fi
  fi

  _install_log_start configure
  _ff_cmd_traps
  # A new own domain must point here before a certificate is asked for.
  if [[ -n ${FF_CFG_NEW[FRONTEND_URL]:-} && $FF_CFG_MODE == own ]]; then
    FF_MODE=own FF_HOST=$FF_CFG_HOST FF_STORAGE=$FF_CFG_STORAGE FF_ADDR_FROM_FILE="" FF_HTTPS=own FF_DOMAIN=$FF_CFG_HOST
    _install_dns_step
    if [[ $FF_MODE == sslip ]]; then
      _cfg_address sslip "$FF_HOST"
      if ((${#FF_CFG_KEYS[@]} == 0)); then
        say "Nothing to change; the settings are as they were."
        trap - ERR INT TERM HUP
        _install_log_stop
        return 0
      fi
    fi
  fi
  if ! _ff_lock; then
    install_fail "$FF_BUSY, so the settings were not changed." \
      "wait a few minutes for it to finish, then run sudo freeframe configure again."
  fi
  # Again under the lock: a restore may have stopped part-way meanwhile.
  _ff_refuse_unfinished_restore configure logged

  FF_STEP="saving the settings"
  # Plain HTTP goes through switch_to_http_mode, which writes the address
  # keys (after its own backup) and restarts FreeFrame.
  if [[ -n ${FF_CFG_NEW[FRONTEND_URL]:-} && $FF_CFG_MODE == off ]]; then http_switch=1; fi
  backup=$(env_backup "$file") ||
    install_fail "Could not back up $file, so nothing was changed." "check that the disk is not full, then run sudo freeframe configure again."
  for k in "${FF_CFG_KEYS[@]}"; do
    if ((http_switch)); then
      case $k in
        FREEFRAME_HTTPS | FRONTEND_URL | DOMAIN | S3_PUBLIC_ENDPOINT | STORAGE_DOMAIN | STORAGE_ROUTED | STORAGE_PORT_BIND) continue ;;
      esac
    fi
    if ! env_set "$file" "$k" "${FF_CFG_NEW[$k]}"; then
      install_fail "The setting $k could not be saved." \
        "put the settings from before back with: sudo cp $(_ff_q "$backup") $(_ff_q "$file"), then run sudo freeframe configure again."
    fi
  done
  say "Saved. The settings from before are in $backup"
  FF_STATE="The new settings are saved. To put the ones from before back, run: sudo cp $(_ff_q "$backup") $(_ff_q "$file") && sudo freeframe restart"
  if ((!restart)); then
    say "The $(env_get "$file" FREEFRAME_CHANNEL) channel is used from the next sudo freeframe update."
    trap - ERR INT TERM HUP
    _install_log_stop
    return 0
  fi

  FF_STEP="restarting FreeFrame"
  if ((http_switch)); then
    if ! switch_to_http_mode "$file" "$FF_CFG_HOST"; then
      install_fail "FreeFrame could not be switched to plain HTTP." "see why with: sudo freeframe logs"
    fi
  else
    say "Restarting FreeFrame with the new settings..."
    if ! _ff_logged dc up -d --no-build --force-recreate; then
      install_fail "FreeFrame could not be restarted with the new settings." "see why with: sudo freeframe logs"
    fi
  fi
  url=$(env_get "$file" FRONTEND_URL)
  FF_STEP="waiting for FreeFrame to answer"
  if ! _ff_wait_healthy "$FF_CFG_MODE" "$FF_CFG_HOST"; then
    install_fail "FreeFrame did not answer at $url after the change." "see why with: sudo freeframe logs"
  fi
  if [[ -n ${FF_CFG_NEW[FRONTEND_URL]:-} && $FF_CFG_MODE != off ]]; then
    FF_STEP="waiting for the HTTPS certificate"
    say "Waiting for the HTTPS certificate from Let's Encrypt (usually under a minute)..."
    hosts=("$FF_CFG_HOST")
    [[ $FF_CFG_STORAGE != bundled ]] || hosts+=("storage.$FF_CFG_HOST")
    ok=1
    for h in "${hosts[@]}"; do
      if ! _ff_wait_for "${FF_CERT_WAIT:-300}" 10 cert_issued "$h"; then
        ok=0
        break
      fi
    done
    if ((ok)); then
      say "The certificate is in place."
    else
      warn "The HTTPS certificate for $h has not arrived yet, so browsers show a warning until it does."
      warn "Check that the DNS records point at ${FF_IP:-this server} and that ports 80 and 443 are open to the internet,"
      warn "then run: sudo freeframe restart"
    fi
  fi
  trap - ERR INT TERM HUP
  say ""
  say "FreeFrame runs at $url with the new settings."
  _install_log_stop
}

