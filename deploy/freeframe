# _ff_disk_line LABEL PATH: used, total and free space of the filesystem
# holding PATH (or its nearest existing parent).
_ff_disk_line() {
  local label=$1 p=$2 u t a
  while [[ ! -e $p && $p != / ]]; do p=$(dirname "$p"); done
  read -r u t a < <(df -Pk "$p" 2>/dev/null | awk 'NR == 2 { print $3, $2, $4 }') || true
  if [[ $u =~ ^[0-9]+$ && $t =~ ^[0-9]+$ && $a =~ ^[0-9]+$ ]]; then
    say "  $label: $(_ff_human_size $((u * 1024))) used of $(_ff_human_size $((t * 1024))), $(_ff_human_size $((a * 1024))) free"
  else
    say "  $label: the free space could not be read"
  fi
}

_ff_mount_of() {
  local p=$1
  while [[ ! -e $p && $p != / ]]; do p=$(dirname "$p"); done
  df -Pk "$p" 2>/dev/null | awk 'NR == 2 { print $6 }'
}

cmd_status() {
  local root file ch ver pinned url mode host storage latest line svc state st s found end smtp
  local next timer dir last n bytes undo healthy=0
  local -a all=() rows=() dumps=()
  root=$(ff_root)
  file="$root/.env.prod"
  if ((${#FF_ARGS[@]})); then _ff_bad_usage "freeframe status takes no other words."; fi
  _ff_need_root status
  _ff_need_install
  ch=$(ff_channel "$file")
  _ff_check_channel "$ch"
  ver=$(ff_version)
  pinned=$(env_get "$file" FREEFRAME_VERSION)
  url=$(env_get "$file" FRONTEND_URL)
  host=$(_ff_url_host "$url")
  mode=$(env_get "$file" FREEFRAME_HTTPS)
  mode=${mode:-off}
  storage=$(env_get "$file" FREEFRAME_STORAGE)

  say "FreeFrame on this server"
  if [[ -n $pinned ]]; then
    say "  Version:      $ver (pinned in $file), $ch channel"
  else
    say "  Version:      $ver, from the $ch channel"
  fi
  if latest=$(remote_version "$ch"); then
    if _ff_version_gt "$latest" "$ver"; then
      say "  Updates:      $latest is available on the $ch channel. To move to it, run: sudo freeframe update"
      if [[ -n $pinned ]]; then
        say "                (first delete the FREEFRAME_VERSION line from $file, which keeps this server on $pinned)"
      fi
    else
      say "  Updates:      none; this is the newest release on the $ch channel"
    fi
  else
    say "  Updates:      Could not check for a newer release (GitHub did not answer)."
  fi
  if _update_undo_read; then
    # The record also stands while an update runs; the lock tells them apart.
    if _ff_lock_busy; then
      say "                An update is running right now (it started ${FF_UNDO_TIME:-a moment ago}). Check again once it has finished."
    else
      say "                An update did not finish. To go back to ${FF_UNDO_VERSION:-the version from before}, run: sudo freeframe rollback"
    fi
  fi
  say "  Web address:  $url"
  if probe_health "$mode" "$host"; then
    healthy=1
    say "  Health:       FreeFrame answers at its web address"
  else
    say "  Health:       FreeFrame does not answer at its web address (see why with: sudo freeframe logs)"
  fi
  if [[ $mode != off ]]; then
    if end=$(cert_expiry "$host"); then
      say "  Certificate:  valid until $end"
    elif ((!healthy)); then
      say "  Certificate:  not checked: FreeFrame's web entrance (Traefik) is not answering. Start it with: sudo freeframe restart"
    else
      say "  Certificate:  not issued yet, so browsers show a warning. Check that the DNS records point here, then run: sudo freeframe restart"
    fi
  fi
  if [[ $storage == bundled ]]; then
    say "  Footage:      kept on this server"
  else
    say "  Footage:      in the S3 bucket $(env_get "$file" S3_BUCKET)"
  fi
  smtp=$(env_get "$file" SMTP_HOST)
  if [[ -n $smtp ]]; then
    say "  Email:        sent through $smtp"
  else
    say "  Email:        not set up, so sign-in codes and invitations are not sent (sudo freeframe configure)"
  fi

  say ""
  say "Parts of FreeFrame:"
  if st=$(dc ps -a --format '{{.Service}}|{{.State}}|{{.Status}}' 2>/dev/null) &&
    s=$(dc config --services 2>/dev/null); then
    mapfile -t rows <<<"$st"
    mapfile -t all <<<"$s"
    for svc in "${all[@]}"; do
      [[ -n $svc ]] || continue
      found=""
      for line in ${rows[@]+"${rows[@]}"}; do
        if [[ ${line%%|*} == "$svc" ]]; then found=$line; fi
      done
      if [[ -n $found ]]; then
        state=${found#*|}
        printf '  %-20s %-9s %s\n' "$svc" "${state%%|*}" "${state#*|}"
      else
        printf '  %-20s %s\n' "$svc" "not created"
      fi
    done
  else
    say "  Docker does not answer, so the state of each part is not known."
    say "  What to try: sudo systemctl start docker, then sudo freeframe restart"
  fi

  say ""
  say "Disk:"
  _ff_disk_line "$root" "$root"
  if [[ $(_ff_mount_of /var/lib/docker) != "$(_ff_mount_of "$root")" ]]; then
    _ff_disk_line "Docker's data (/var/lib/docker)" /var/lib/docker
  fi

  say ""
  say "Backups (of the database, in $root/backups):"
  dir="$root/backups"
  mapfile -t dumps < <(_ff_backup_dumps "$dir")
  n=${#dumps[@]}
  if ((n == 0)); then
    say "  Last:         none yet (to make one now: sudo freeframe backup)"
  else
    last=${dumps[n - 1]}
    bytes=$(_ff_size_bytes "$last") || bytes=0
    say "  Last:         $(_ff_stamp_date "${last##*/}") (${last##*/}, $(_ff_human_size "$bytes")); $n kept"
  fi
  timer=$(systemctl show -p ActiveState --value freeframe-backup.timer 2>/dev/null) || timer=""
  if [[ $timer == active ]]; then
    next=$(systemctl show -p NextElapseUSecRealtime --value freeframe-backup.timer 2>/dev/null) || next=""
    say "  Next:         ${next:-tonight at about 3:00}"
  else
    say "  Next:         none: the nightly backup is off. To turn it on, run: sudo systemctl enable --now freeframe-backup.timer"
  fi
  undo=$(_restore_undo_path)
  if [[ -n $undo ]]; then
    say "  A restore did not finish. To go back to the database as it was before it, run: sudo freeframe restore --yes $(_ff_q "$undo")"
  fi
  say "  These backups are on this server only, so they do not survive losing it. Copy them somewhere"
  say "  else now and then; the guide explains how: $FF_GUIDE_URL"
}

# cmd_logs: `freeframe logs [PART]`: the last 200 lines, then new ones as
# they come (Ctrl-C to stop).
cmd_logs() {
  local svc out s ok=0
  local -a all=()
  if ((${#FF_ARGS[@]} > 1)); then
    _ff_bad_usage "freeframe logs takes at most one part of FreeFrame, for example: sudo freeframe logs api"
  fi
  _ff_need_root logs
  _ff_need_install
  svc=${FF_ARGS[0]:-}
  if [[ -z $svc ]]; then
    dc logs -f --tail 200
    return
  fi
  if out=$(dc config --services 2>/dev/null); then
    mapfile -t all <<<"$out"
    for s in "${all[@]}"; do
      if [[ $s == "$svc" ]]; then ok=1; fi
    done
    if ((!ok)); then
      _ff_stop 2 "FreeFrame has no part called '$svc'." "use one of: ${all[*]}; or leave it out to see them all."
    fi
  fi
  dc logs -f --tail 200 "$svc"
}

# _ff_manage_stop CODE MESSAGE WHAT_TO_TRY: _ff_stop, with the lines also in
# install.log (restart does not copy the screen into the log).
_ff_manage_stop() {
  _ff_log_lines "$2" "What to try: $3"
  _ff_stop "$1" "$2" "$3"
}

# cmd_restart: `freeframe restart`: every container recreated from the
# images already here (dc up -d --no-build --force-recreate), then a wait
# until FreeFrame answers. An unfinished restore's undo record is left alone.
cmd_restart() {
  local root url
  root=$(ff_root)
  if ((${#FF_ARGS[@]})); then _ff_bad_usage "freeframe restart takes no other words."; fi
  _ff_need_root restart
  _ff_need_install
  _ff_need_finished_install restart
  FF_ACTOR="the restart"
  _ff_log_open restart
  # The lock first: a restore that is running has the same undo record as
  # one that stopped part-way, and only the lock tells them apart.
  if ! _ff_lock; then
    _ff_manage_stop 1 "$FF_BUSY, so FreeFrame was not restarted." \
      "wait a few minutes for it to finish, then run sudo freeframe restart again."
  fi
  _ff_refuse_unfinished_restore restart
  say "Restarting FreeFrame..."
  if ! _ff_logged dc up -d --no-build --force-recreate; then
    _ff_manage_stop 1 "FreeFrame could not be restarted." \
      "the reason is at the end of ${FF_LOG:-the output above}. Then run sudo freeframe restart again."
  fi
  say "Waiting for FreeFrame to finish starting..."
  if ! _ff_wait_for "${FF_API_WAIT:-600}" 5 _ff_logged dc exec -T api curl -fsS http://localhost:8000/health; then
    _ff_manage_stop 1 "FreeFrame was restarted but did not finish starting within $(((${FF_API_WAIT:-600} + 59) / 60)) minutes." \
      "see why with: sudo freeframe logs"
  fi
  url=$(env_get "$root/.env.prod" FRONTEND_URL)
  say "FreeFrame is running again: $url"
}

# ------------------------------------------------------------
# Commands
# ------------------------------------------------------------

usage() {
  cat <<'EOF'
freeframe: install and look after FreeFrame on this server.

Usage: sudo freeframe <command> [options]

Commands:
  install     Set up FreeFrame on this server (asks a few questions)
  update      Back up, then move to the newest release on your channel
              (updates this command first; --channel picks another channel)
  rollback    After an update that did not come up: go back to the version
              from before, with the database as it was just before it
  configure   Change the answers you gave (web address, email, storage);
              with --yes, give only the new answers as options
  backup      Save a copy of the database to /opt/freeframe/backups now
              (this also runs every night at 3:00; the newest 7 are kept)
  restore     List the backups; restore FILE puts one back (replaces the
              current database, after saving a copy of it)
  status      Show the version, whether everything is running, disk space,
              backups and whether a newer release is out
  logs        Show FreeFrame's recent messages and follow new ones (Ctrl-C
              stops); logs api shows one part only
  restart     Restart every part of FreeFrame and wait until it answers
  help        Show this list

Answers can be given ahead of time as options or environment variables, for
example --domain review.yourstudio.com or FREEFRAME_DOMAIN=review.yourstudio.com.
Options: --domain --https --acme-email --storage --s3-endpoint --s3-bucket
  --s3-access-key --s3-secret-key --s3-region --smtp-host --smtp-port
  --smtp-user --smtp-password --smtp-from --admin-name --admin-email
  --admin-password --channel --yes
  --quiet     (backup) print nothing unless something goes wrong

Passwords and keys (--admin-password, --smtp-password, --s3-secret-key) are
better given as FREEFRAME_ADMIN_PASSWORD, FREEFRAME_SMTP_PASSWORD and
FREEFRAME_S3_SECRET_KEY, or typed when asked: options on the command line can
be seen by other users of this server (for example with ps), and variables
cannot.
EOF
}

main() {
  # Kept for update, which runs its new copy with the same arguments.
  FF_ORIG_ARGS=("$@")
  parse_args "$@"
  case $FF_CMD in
    help) usage ;;
    install) cmd_install ;;
    backup) cmd_backup ;;
    restore) cmd_restore ;;
    update) cmd_update ;;
    rollback) cmd_rollback ;;
    configure) cmd_configure ;;
    status) cmd_status ;;
    logs) cmd_logs ;;
    restart) cmd_restart ;;
    *)
      warn "Unknown command: $FF_CMD"
      warn "What to try: run $(_ff_help_cmd) to see the commands."
      return 2
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if ((BASH_VERSINFO[0] < 4)); then
    echo "freeframe needs bash 4 or newer (this is bash $BASH_VERSION)." >&2
    echo "What to try: run it on the Ubuntu or Debian server, not on this computer." >&2
    exit 1
  fi
  set -Eeuo pipefail
  main "$@"
fi
